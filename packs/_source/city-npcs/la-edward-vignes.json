      "_id": "f608c673d4d4422e",
      "name": "Dominate — 3 Advanced — Chain the Psyche",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>When issuing a Dominate command, spend a Blood Trait and decide how many future attempts to resist or recover memories you wish to crush, spending one Mental Trait per attempt (these Traits are unavailable the rest of the night, though Willpower expenditure restores them normally). If the subject tries to disobey or recover memories within that limit, agonizing pain incapacitates him for 10 minutes; the power fades once all guarded attempts have been used.</p>",
        "source": "Camarilla Guide, Disciplines",
        "discipline": "Dominate",
        "level": "advanced",
        "challengeType": "mental",
        "bloodCost": "One Blood Trait, plus one Mental Trait per resisted attempt crushed",
        "retestAbility": "",
