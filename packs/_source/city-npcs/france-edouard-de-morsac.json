    {
      "_id": "d2d6cbe7a9784cf7",
      "name": "Fortitude \u2014 2 Intermediate \u2014 Brace for Impact",
      "type": "power",
      "img": "icons/magic/control/buff-strength-muscle-damage-orange.webp",
      "system": {
        "description": "<p>A combination power blending Potence's unnatural strength with Fortitude's supernatural toughness, letting a Cainite brace her whole body against blunt-force impacts: falling, car crashes, explosions, or being struck by very large objects. It does not help against ordinary combat damage (fists, bullets, blades) or against fire, electricity, sunlight, or other energy-based damage \u2014 only against impacts affecting the entire body, and only if the character can see the impact coming and brace for it.</p>",
        "discipline": "Fortitude",
        "level": "intermediate",
        "challengeType": "static",
        "bloodCost": "",
        "retestAbility": "Athletics",
        "duration": "Instantaneous (per impact)",
        "activation": "reflexive",
        "prerequisites": "Fortitude (3), Potence (3)",
        "source": "Mexico City by Night, Chapter Five: Storytelling (Unique Abilities)"
