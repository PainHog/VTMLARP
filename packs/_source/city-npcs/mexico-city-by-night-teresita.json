    {
      "_id": "a843ad1fdd964ce2",
      "name": "Obfuscate — 3 Advanced — Cloak the Aura",
      "type": "power",
      "img": "icons/magic/unholy/silhouette-evil-horned-summon.webp",
      "system": {
        "description": "<p>With this power, you can completely cloak your aura from the prying eyes of others. By expending a Willpower Trait, you can completely conceal your aura or change it at will. Others attempting to use Aura Perception, Telepathy, or Soul Scan on you must defeat you in an opposed Mental Challenge to break the Cloak, and if broken, must defeat you in an additional Mental Challenge for any of those powers to have an effect. Cloak the Aura's effects override those of any lesser Obfuscate power.</p>",
        "source": "Laws of Elysium, Disciplines",
        "discipline": "Obfuscate",
        "level": "advanced",
