    {
      "_id": "c94d9c8e4d254b5d",
      "name": "Celerity — 3 Advanced — Stutter-Step",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Calling upon her preternatural speed, a Kindred using this power appears to undertake several actions at once, &ldquo;flickering&rdquo; from one action to the next. This is particularly useful in combat, as one's foe cannot guess which of the actions he perceives is the one with which the character follows through. The character seems to be a dervish while this power is in effect, beginning countless feints, dodges and parries.</p><p><strong>System:</strong> The player spends a Blood Trait to activate this power. For the turn in which the character calls upon this power, she may use six additional Physical Traits (Graceful x2, Nimble x2, Quick x2) for the purposes of defense. These bonus Traits do not apply to the character's attacks. She also gains a single &ldquo;Stutter&rdquo; retest in any challenge, applicable for defensive actions. The Stutter retest is always the last retest declared in a challenge, unless the attacker declares the use of Might.</p>",
        "source": "Clanbook: Brujah, Chapter Two",
        "discipline": "Celerity",
        "level": "advanced",
        "challengeType": "physical",
        "bloodCost": "One Blood Trait",
        "retestAbility": "",
        "duration": "One turn",
        "activation": "reflexive",
        "active": false,
        "prerequisites": "Celerity (7, Master tier)"
