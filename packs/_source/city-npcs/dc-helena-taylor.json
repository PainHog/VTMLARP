    {
      "_id": "f17b0d605acd48ab",
      "name": "Thaumaturgy — 2 Intermediate — Command the Freshly Dead",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>The vampire can command any ghost she can see to obey her, receiving answers to questions within the ghost's realm of awareness or sending it to deliver a message. She cannot compel a ghost to perform any task requiring a material form.</p><p><strong>System:</strong> The vampire must first use See the Dead to locate a desired ghost, then wins a contested Willpower roll against the wraith (most ghosts have 5 Willpower). Each success scored over the wraith's own answers one question or performs one simple action.</p>",
        "source": "Libellus Sanguinis II: Keepers of the Word, Book Two: Usurpers",
        "discipline": "Thaumaturgy",
        "level": "intermediate",
        "challengeType": "static",
        "bloodCost": "",
        "retestAbility": "Willpower",
        "duration": "Instant",
        "activation": "challenge",
        "active": false,
        "prerequisites": "See the Dead"
      },
