    {
      "_id": "72b05f8446eb49c6",
      "name": "Auspex — 3 Advanced — Doubletalk",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Doubletalk is a trick passed among the Toreador for centuries. The character speaks a full sentence very quickly and softly, hidden between words spoken normally so that it sounds like a conversational placeholder ('uh,' 'er,' 'hmmm') to most listeners. Someone familiar with the power can pick out the hidden sentence; true masters can compress entire soliloquies into a single grunt. This is not an exclusive secret of the clan &mdash; some Tremere and Malkavians have also mastered the technique.</p><p>To listen for Doubletalk in a conversation, the player makes a Static Mental Challenge (difficulty five Traits); success means the character hears what was said, while failure means she heard nothing. To speak Doubletalk, the player makes a Static Mental Challenge (difficulty six Traits); success lets the character seamlessly insert the hidden phrase, while failure means she isn't understood. A single challenge suffices for an entire conversation. This power costs five Experience Traits to learn.</p>",
        "source": "Clanbook: Toreador, Chapter Two",
        "discipline": "Auspex",
        "level": "advanced",
        "challengeType": "mental",
        "bloodCost": "",
        "retestAbility": "",
        "duration": "Single conversation",
        "activation": "challenge",
        "prerequisites": "Auspex, Celerity, and Obfuscate"
      },
