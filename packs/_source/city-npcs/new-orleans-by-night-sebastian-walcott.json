    {
      "_id": "12b80c7556024b0e",
      "name": "Auspex — 3 Advanced — Anima Gathering",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Originally used to lead warrior-caste mystics on vision quests, this vizier technique lets a willing seer bring companions with him into the astral realms. All would-be participants must form an unbroken chain of physical contact with the character. Spend a Blood Trait for each \"follower\" you wish to bring along, up to a maximum of half your permanent Mental Traits (rounded down), then leave your body as per Psychic Projection. Each follower is treated as though she knows Psychic Projection regardless of her actual Auspex rating, using the leader's rolled successes. On the astral plane, followers must remain within roughly 100 feet of the leader, tethered to him and unable to break the connection. Any follower who loses physical contact with the leader instantly returns to her body and loses three Mental Traits, falling unconscious for the rest of the night if this reduces her to zero Mental Traits.</p>",
        "source": "Clanbook: Assamite, Chapter Two",
        "discipline": "Auspex",
        "level": "advanced",
        "challengeType": "none",
        "bloodCost": "1 Blood Trait per follower (max half permanent Mental Traits, rounded down)",
        "retestAbility": "",
        "duration": "Until the astral projection ends",
        "activation": "reflexive",
        "prerequisites": "Auspex (Psychic Projection)"
      },
      "effects": [],
      "folder": null,
      "sort": 0,
      "flags": {},
      "_stats": {
        "systemId": "vtmlarp",
