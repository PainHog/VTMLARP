        "lastModifiedBy": null
      }
    },
    {
      "_id": "35ddbeb561c644cf",
      "name": "Potence — 3 Advanced — Esprit de Corps",
      "type": "power",
      "img": "icons/skills/melee/weapons-crossed-swords-yellow.webp",
      "system": {
        "description": "<p>A Brujah with this power can stir the hearts of his allies, granting them courage and strength for the cause they fight for. Once employed, those affected fight fearlessly and with great strength, following the Cainite into battle against even overwhelming odds.</p><p><strong>System:</strong> The player rolls Strength + Intimidation (difficulty 7). Any opposing power meant to inspire fear or otherwise prevent an affected ally from fighting suffers +2 difficulty. All affected allies &mdash; mortal, ghoul, or Cainite &mdash; also gain one dot of Potence for the scene per two successes. The number of successes determines how many allies are affected, from a single person (1 success) up to every ally in the vampire's immediate vicinity, such as a courtyard or battle group (5 successes).</p>",
        "source": "Libellus Sanguinis II: Keepers of the Word, Book Three: Zealots",
        "discipline": "Potence",
        "level": "advanced",
        "challengeType": "social",
        "bloodCost": "",
        "retestAbility": "Strength",
        "duration": "One scene",
        "activation": "challenge",
        "active": false,
        "prerequisites": "Potence (5), Presence (5)"
      },
      "effects": [],
      "folder": null,
      "sort": 0,
      "flags": {},
