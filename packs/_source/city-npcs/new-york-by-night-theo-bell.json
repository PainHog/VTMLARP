    {
      "_id": "8d5321c9a6d3483b",
      "name": "Potence — 3 Advanced — Gentle Nudge",
      "type": "power",
      "img": "icons/magic/unholy/silhouette-evil-horned-summon.webp",
      "system": {
        "description": "<p>Facetiously named, this power allows the Kindred to physically knock another character away from herself with the slightest of touches. Although this power does no damage in and of itself, its use is quite humbling &mdash; to be hurled away from an elder in a social setting has its embarrassing repercussions. Some Kindred use this power surreptitiously, touching their victims and sending them reeling across the room; others use it as a not-so-subtle display of their might, giving their victim a casual slap with overwhelming results.</p><p><strong>System:</strong> The player spends a Blood Trait and must succeed in a physical challenge to touch the target (this may be done surreptitiously, but the player may not make use of other Potence benefits). The challenge is not required if the subject allows the player to touch him (a handshake, a &ldquo;friendly&rdquo; hand on the shoulder, etc). This power hurls the victim 20 feet directly away from the invoking character. If the subject strikes a wall or other solid obstacle, he suffers two health levels of bashing damage. Otherwise, the character needs to win a static physical challenge against six Traits to remain standing.</p>",
        "source": "Clanbook: Brujah, Chapter Two",
        "discipline": "Potence",
        "level": "advanced",
        "challengeType": "physical",
        "bloodCost": "One Blood Trait",
        "retestAbility": "",
        "duration": "Instant",
        "activation": "challenge",
        "active": true,
        "prerequisites": "Potence (6, Master tier)"
      },
      "effects": [],
      "folder": null,
      "sort": 0,
      "flags": {},
      "_stats": {
