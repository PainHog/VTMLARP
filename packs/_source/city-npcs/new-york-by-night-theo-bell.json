    {
      "_id": "289a7bc5d90040f5",
      "name": "Celerity — 3 Advanced — Fleetness",
      "type": "power",
      "img": "icons/magic/unholy/silhouette-evil-horned-summon.webp",
      "system": {
        "description": "<p>In addition to the benefits of Legerity, spending a Blood Trait grants automatic wins on all ties involving speed or agility regardless of relative Traits, except against another vampire using a similarly-effective Discipline power such as Potence's Puissance, in which case ties are resolved normally.</p>",
        "source": "Faith and Fire, Disciplines",
