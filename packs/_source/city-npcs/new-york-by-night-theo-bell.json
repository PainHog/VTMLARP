    {
      "_id": "887df2abc2b74e38",
      "name": "Potence — 3 Advanced — Demolition",
      "type": "power",
      "img": "icons/magic/unholy/silhouette-evil-horned-summon.webp",
      "system": {
        "description": "<p>You now possess power so colossal that only the suicidal or the insane would cross you in a test of strength. You are so dangerous in hand-to-hand combat that you inflict two additional wounds if you win the challenge. If your opponent uses Demolition, and each of you wins one of the tests, you both take full damage.</p>",
        "source": "Laws of Elysium, Disciplines",
