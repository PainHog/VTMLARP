    {
      "_id": "89101d378e0e47f7",
      "name": "Quietus — 3 Advanced — Baal's Bloody Talons",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A progressive development of Baal's Caress, this power coats an edged weapon with a blood-based poison so potent it corrodes the very weapon that bears it. You coat a bladed weapon with your own blood, spend one or more Blood Traits, and make a Static Mental Challenge against a difficulty of 7 Traits (retest Willpower). The weapon now does aggravated damage and gains a number of Envenomed Traits equal to the Blood Traits spent, added to its bonus Traits. On a successful strike, make a Simple Test for each Envenomed Trait the weapon currently has; success inflicts an additional health level of damage. At the end of each turn the weapon loses one Envenomed Trait; when the last is lost, the weapon is destroyed by the corrosive venom.</p>",
        "source": "Clanbook: Assamite, Chapter Two",
        "discipline": "Quietus",
        "level": "advanced",
        "challengeType": "static",
        "bloodCost": "1 or more Blood Traits",
        "retestAbility": "Willpower",
        "duration": "Until the weapon is destroyed",
        "activation": "challenge",
        "prerequisites": "Quietus (Baal's Caress)"
      },
