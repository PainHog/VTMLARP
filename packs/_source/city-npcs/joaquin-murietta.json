    {
      "_id": "2aa1d1388f5547c3",
      "name": "Celerity — 3 Advanced — Precision",
      "type": "power",
      "img": "icons/magic/unholy/silhouette-evil-horned-summon.webp",
      "system": {
        "description": "<p>You focus your preternatural speed into the smallest of motions, allowing feats of fine manipulation beyond mortal (or even ordinary Cainite) capability, such as micro-precise crafting or delicate surgery. Spend two Blood Traits and a Willpower Trait, then spend five minutes in a trance-like state of concentration. For the next five minutes you gain two free retests on all challenges related to precision, fine manipulation, or moving something without disturbing its surroundings. Any actions that do not involve fine manipulation require you to bid an additional Trait, and you lose all ties on any challenge involving gross physical movement, including combat.</p>",
        "source": "Clanbook: Assamite, Chapter Two",
        "discipline": "Celerity",
        "level": "advanced",
        "challengeType": "none",
        "bloodCost": "2 Blood Traits and 1 Willpower Trait",
