      "_id": "9ea0e2eb692a466f",
      "name": "Thaumaturgy (Spirit Manipulation) — 3 Advanced — Duality",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Spending a Willpower Trait and winning a Static Mental Challenge lets you exist in the physical and spirit worlds simultaneously, able to interact with objects and beings in both and use Disciplines in either. After entering, you make Simple Tests to determine duration, with a second consecutive loss risking a backlash that stranding you fully in the spirit realm. While active, you must bid two additional Traits on all challenges and remain vulnerable to attacks from both worlds.</p>",
        "source": "Camarilla Guide, Disciplines",
        "discipline": "Thaumaturgy (Spirit Manipulation)",
        "level": "advanced",
        "challengeType": "mental",
