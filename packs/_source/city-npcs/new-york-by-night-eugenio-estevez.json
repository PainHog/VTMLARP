    {
      "_id": "f24010b786e043a0",
      "name": "Thaumaturgy (Spirit Manipulation) — 2 Intermediate — Entrad Ephemera",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>You bind a spirit into an object, either to imprison it or to create a fetish that channels the spirit's power through the item, with effects dependent on the spirit and item involved and worked out with the Storyteller. Activating the fetish requires spending a Willpower Trait and making a Simple Test; each consecutive loss risks the fetish failing and, on a third loss, being destroyed and freeing the trapped spirit.</p>",
        "source": "Camarilla Guide, Disciplines",
        "discipline": "Thaumaturgy (Spirit Manipulation)",
        "level": "intermediate",
        "challengeType": "mental",
