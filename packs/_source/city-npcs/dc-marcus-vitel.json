    {
      "_id": "c2e40594566d4a46",
      "name": "Obtenebration — 2 Intermediate — Dark Steel",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A combination power blending Obtenebration and Potence. Where Arms of Ahriman lets a Lasombra summon tentacles of pure shadow to grip and strike, this bastardized variant grants those pseudopods far greater strength and endurance, catching Cainites used to the ordinary manifestation off guard. Each success summons one tentacle, emerging from any nearby patch of shadow (beneath furniture, from within the vampire's own cloak, and so on). Every tentacle is eight feet long and has Strength and Dexterity equal to twice the wielder's Obtenebration rating. The vampire may feed a tentacle additional Blood Points, one for one, raising its ratings further. A Dark Steel tentacle deals Strength+2 crushing damage, has six health levels of its own, and — like the wielder — takes extra harm from fire and sunlight.</p>",
        "discipline": "Obtenebration",
        "level": "intermediate",
        "challengeType": "physical",
        "bloodCost": "2 Blood Points, plus 1 per point of tentacle enhancement",
        "retestAbility": "Occult",
        "duration": "One scene or until dismissed",
        "activation": "challenge",
        "prerequisites": "Obtenebration (3), Potence (3)",
        "source": "Libellus Sanguinis I: Masters of the State, Book One: Magisters"
      },
      "folder": null,
      "sort": 0,
