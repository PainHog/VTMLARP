      "_id": "df97535040c3483e",
      "name": "Obtenebration — 3 Advanced — Ahriman's Demesne",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Spend any number of Willpower Traits and concentrate for three turns to summon a billowing cloud of darkness in a 50-pace radius, placing the area under Shroud of Night. For each of the next three turns, everyone you wish to destroy in the area must win a Static Physical Challenge against the Willpower Traits you spent or take three Health Levels of aggravated damage. The cloud then collapses, and anyone who died within it vanishes entirely, leaving only belongings. The power cannot be invoked again that night.</p>",
        "source": "Sabbat Guide, Disciplines",
        "discipline": "Obtenebration",
        "level": "advanced",
        "challengeType": "physical",
        "bloodCost": "Any number of Willpower Traits",
        "retestAbility": "",
        "duration": "Three turns, then ends for the night",
