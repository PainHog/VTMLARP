    {
      "_id": "a92212f76fb249d0",
      "name": "Auspex — 3 Advanced — Crocodile's Tongue",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A character with this power instinctively understands what one other person in a conversation (living or undead) wants to hear. If she can find a way to phrase what she wants so that it sounds like what that person wants to hear, this helps her get her point across, ingratiate herself, or accumulate favors. Unlike Telepathy, the subject need not be actively thinking about what she wants to hear.</p><p>The character must spend at least a minute speaking with the subject and win a Mental Challenge against the subject. If both players agree, they may instead roleplay the conversation directly, with the subject's player reacting favorably and offering suggestions that aid the character with the power. If the players resort to mechanics, the character with the power initiates a Social Challenge against the subject, winning ties.</p>",
        "source": "Clanbook: Toreador, Chapter Two",
        "discipline": "Auspex",
        "level": "advanced",
        "challengeType": "mental",
        "bloodCost": "",
        "retestAbility": "",
        "duration": "Single conversation",
        "activation": "challenge"
      },
