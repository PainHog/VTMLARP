    {
      "_id": "06c0e0610ee5418f",
      "name": "Chimerstry — 3 Advanced — Shared Nightmare",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>An expansion of Horrid Reality that lets the Ravnos inflict a terrifying, illusory catastrophe on multiple victims at once, each convinced they alone are experiencing it.</p><p><strong>System:</strong> The Ravnos spends one Blood Point per target plus two Willpower, then rolls Manipulation + Subterfuge once, comparing the result against each target's Perception + Self-Control individually. Any target who fails believes the Horrid Reality is happening to them personally.</p><p><strong>MET:</strong> Elder Discipline. The Ravnos spends one Willpower Trait per target (maximum five targets) plus one Social Trait, bid against all targets simultaneously; each target's result is compared individually rather than as a group challenge. Any target who loses suffers the full effects of Horrid Reality.</p>",
        "source": "Clanbook: Ravnos (Revised), Disciplines",
        "discipline": "Chimerstry",
        "level": "advanced",
        "challengeType": "social",
        "bloodCost": "1 per target + Willpower",
        "retestAbility": "",
        "duration": "Scene",
        "system_": "",
        "activation": "challenge",
        "active": true,
        "prerequisites": "Chimerstry 6 (Elder)"
