    {
      "_id": "efd12a359bf3422b",
      "name": "Dominate — 3 Advanced — Speak Through the Blood",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Spend a permanent Willpower Trait and win a Mental Challenge against any vampire of your own bloodline, regardless of distance, to implant a broad, generic long-term command (specific or immediate orders are not possible). The command lasts five years per permanent Willpower Trait spent, gradually shaping the subject's agenda without her realizing the source, and combines potently with powers like Mass Manipulation. A vampire who reaches Golconda becomes immune, though unknowingly so.</p>",
        "source": "Camarilla Guide, Disciplines",
        "discipline": "Dominate",
        "level": "advanced",
        "challengeType": "mental",
