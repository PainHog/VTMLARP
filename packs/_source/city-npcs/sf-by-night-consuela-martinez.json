    {
      "_id": "d4f0c2051a57491b",
      "name": "Obtenebration — 3 Advanced — Tenebrous Form",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>By spending three Blood Traits and three full turns of concentration, you dissolve into a shadowy, liquid form immune to physical attacks (though not fire, sunlight, or magic), able to slither through cracks and smother victims like a Shroud of Night.</p>",
        "source": "Laws of the Night Revised, Disciplines",
        "discipline": "Obtenebration",
        "level": "advanced",
        "challengeType": "none",
        "bloodCost": "3 Blood Traits",
        "retestAbility": "Occult",
