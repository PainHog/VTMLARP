    {
      "_id": "b8d7ba475b794b52",
      "name": "Obfuscate — 2 Intermediate — Mask of a Thousand Faces",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Your features appear bland and unremarkable to onlookers, or by spending a Mental Trait you can assume a specific guise, copying another's appearance up to the Social Traits you can afford to match, lasting until you sleep, are knocked out, or die.</p>",
        "source": "Laws of the Night Revised, Disciplines",
