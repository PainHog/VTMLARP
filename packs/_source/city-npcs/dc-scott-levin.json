    {
      "_id": "fac8770f4f204c16",
      "name": "Auspex — 2 Intermediate — The Spirit's Touch",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Maintain physical contact with an object or location and concentrate for a turn, expending a Mental Trait, then ask the Narrator one question about who last touched it, whether it was involved in stressful situations, or what strong emotions drove its user. May be used repeatedly for greater insight; objects of powerful emotional resonance may force a derangement upon the user for the scene.</p>",
        "source": "Faith and Fire, Disciplines",
        "discipline": "Auspex",
        "level": "intermediate",
        "challengeType": "mental",
        "bloodCost": "",
        "retestAbility": "Investigation",
        "duration": "Instant, repeatable",
        "activation": "challenge",
        "active": true,
        "prerequisites": ""
      },
