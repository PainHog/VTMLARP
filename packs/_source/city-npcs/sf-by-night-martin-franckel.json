    {
      "_id": "ff2e3642d9c94253",
      "name": "Thaumaturgy (Path of Technomancy) — 2 Intermediate — Remote Access",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Spending a Willpower Trait lets you operate any electronic device in your line of sight directly with your mind, without touching it, for a number of turns equal to your Path of Technomancy score before requiring a Simple Test each turn to maintain the connection. Only a single device may be operated at a time, and if the device is destroyed while in use, you immediately suffer three levels of unhalved bashing damage.</p>",
        "source": "Camarilla Guide, Disciplines",
        "discipline": "Thaumaturgy (Path of Technomancy)",
        "level": "intermediate",
