    {
      "_id": "bc77a2d8aa644a08",
      "name": "Thaumaturgy (Path of Technomancy) — 2 Intermediate — Encrypt/Decrypt",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Touching a device or data container and spending a Willpower Trait, you then spend Mental Traits to mystically scramble its controls or data so only you can use it; each level of Computer Ability you possess counts as two Traits toward this total. Others must win a Static Mental Challenge against the Traits spent to bypass it, and those lacking relevant skills cannot even attempt it. The same process in reverse decrypts a target, and the effect lasts for weeks equal to your permanent Willpower Traits.</p>",
        "source": "Camarilla Guide, Disciplines",
        "discipline": "Thaumaturgy (Path of Technomancy)",
        "level": "intermediate",
        "challengeType": "mental",
        "bloodCost": "",
        "retestAbility": "Occult",
        "duration": "Weeks equal to permanent Willpower Traits",
        "activation": "toggle"
      },
      "effects": [],
