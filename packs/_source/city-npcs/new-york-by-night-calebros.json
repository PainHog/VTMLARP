    {
      "_id": "cd487a77e88c40a0",
      "name": "Obfuscate — 3 Advanced — Cloak the Gathering",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>By spending a Mental Trait per subject, you extend any Obfuscate power you possess over a group, hiding or disguising them collectively; the cloak fails entirely only if you yourself are noticed or violate your power's conditions.</p>",
        "source": "Laws of the Night Revised, Disciplines",
        "discipline": "Obfuscate",
        "level": "advanced",
        "challengeType": "mental",
        "bloodCost": "",
