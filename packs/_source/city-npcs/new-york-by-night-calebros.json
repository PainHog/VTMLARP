    {
      "_id": "00e255e0626d4f18",
      "name": "Obfuscate — 3 Advanced — Create Name",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>After spending three hours in peace establishing a persona, spend a permanent Willpower Trait and win a Static Mental Challenge (Storyteller-set difficulty, typically 10+ Traits) to permanently craft a wholly new identity, complete with appearance, speech, aura, and even apparent thoughts and Psychological traits. You may adopt the persona at will without further tests, and may maintain multiple identities, though only one may be active at a time; switching requires a Willpower Trait and a minute of concentration. Only Methuselah-level Auspex reliably pierces the disguise, though inconsistencies between the persona and your actual skills can also give it away.</p>",
        "source": "Camarilla Guide, Disciplines",
        "discipline": "Obfuscate",
        "level": "advanced",
        "challengeType": "mental",
        "bloodCost": "One permanent Willpower Trait",
        "retestAbility": "",
        "duration": "Permanent identity; switching costs one Willpower Trait and a minute",
        "activation": "toggle"
      },
