    {
      "_id": "dc26b4604e0844ed",
      "name": "Auspex — 2 Intermediate — Artist's Intent",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>By this gift, a Toreador may penetrate the &quot;soul&quot; of an inanimate artwork she examines, interpreting the piece, gleaning the artist's state of mind, the relationship between artist and work, and the stages of the creative process, revealed as a series of progressively paler images looking back into the work's history. Some Toreador use this to critique or authenticate a piece; others monitor their proteges' work for unspoken rebellion or sadness, or seek the &quot;real&quot; story behind a letter proposing an alliance. The power does not function on &quot;living&quot; art still in the act of performance &mdash; a play, a song, or a story being told &mdash; since such work depends on the performer's ongoing intent rather than a fixed, finished creation.</p><p><strong>System:</strong> The character examines the work and the number of successes determines how much she perceives: a single success yields only general feelings with no historical context; two successes offer a vague sense of the work's history; three successes reveal specific details and a fuzzy timeline; four successes grant a definite sense of the artist's emotional state and a reasonable timeline; five successes let the Toreador see the work in stages, feeling what the artist felt at every step of its creation. The difficulty rises for pieces with multiple artists or a long creation span; examining something as vast as a cathedral or castle risks leaving the Toreador a gibbering wreck from informational overload.</p>",
        "source": "Libellus Sanguinis II: Keepers of the Word, Book One: Artisans (Toreador)",
        "discipline": "Auspex",
        "level": "intermediate",
        "challengeType": "mental",
        "bloodCost": "",
        "retestAbility": "Perception",
        "duration": "Instant (per work examined)",
        "activation": "challenge",
        "active": false,
        "prerequisites": "Auspex"
      },
