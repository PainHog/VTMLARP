    {
      "_id": "64255290ef4a4de6",
      "name": "Smothering Darkness",
      "type": "power",
      "img": "icons/magic/air/wind-tornado-blue.webp",
      "system": {
        "description": "<p>A combination power blending Obtenebration and Obfuscate. The Magister summons fluttering shadows that behave like moths drawn to flame, flocking to the nearest light sources — torches, candles, oil lamps — and dousing them. An entire area can be plunged into darkness almost instantly, leaving anyone unprepared for the dark completely helpless. Each success produces one shadow, which douses any flame up to the size of a torch before vanishing; larger fires require multiple shadows to extinguish. Shadows in excess of the available flames flap about causing confusion and fear before dissipating into whatever dark place spawned them. They cause no direct damage, though they may collide with people in their flight.</p>",
        "source": "Libellus Sanguinis I: Masters of the State, Book One: Magisters",
        "discipline": "Obtenebration",
        "level": "basic",
        "challengeType": "mental",
        "bloodCost": "",
        "retestAbility": "Occult",
        "duration": "Until all nearby light sources are doused",
        "activation": "challenge",
        "active": false,
        "prerequisites": "Obtenebration (2), Obfuscate (1)"
      },
      "effects": [],
      "folder": null,
      "sort": 0,
      "flags": {},
