    {
      "_id": "def575ca18744dcd",
      "name": "Command the Wary Steed",
      "type": "power",
      "img": "icons/creatures/mammals/horse-brown-galloping.webp",
      "system": {
        "description": "<p>Through use of this power the Cainite can cause enemies' mounts to rear and bolt, singly or en masse, by the strength of his gaze alone, or bolster the courage and tractability of allied steeds for greater control in battle.</p><p><strong>System:</strong> The player spends a Willpower point and rolls Manipulation + Animal Ken (difficulty 7). Enemy mounts become terrified and nigh uncontrollable: Ride roll difficulties increase by three and mounted combat becomes impossible. Friendly mounts become far more pliant (-2 difficulty on all Ride rolls) and may be coerced into situations they would normally avoid.</p>",
        "source": "Libellus Sanguinis II: Keepers of the Word, Book Three: Zealots",
        "discipline": "Presence",
        "level": "intermediate",
        "challengeType": "social",
        "bloodCost": "",
        "retestAbility": "Manipulation",
        "duration": "One scene",
        "activation": "challenge",
        "active": false,
