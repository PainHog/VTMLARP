    {
      "_id": "8605bd730c204521",
      "name": "Smothering Darkness",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A combination power blending Obtenebration and Obfuscate. The Magister summons fluttering shadows that behave like moths drawn to flame, flocking to the nearest light sources — torches, candles, oil lamps — and dousing them. An entire area can be plunged into darkness almost instantly, leaving anyone unprepared for the dark completely helpless. Each success produces one shadow, which douses any flame up to the size of a torch before vanishing; larger fires require multiple shadows to extinguish. Shadows in excess of the available flames flap about causing confusion and fear before dissipating into whatever dark place spawned them. They cause no direct damage, though they may collide with people in their flight.</p>",
        "source": "Libellus Sanguinis I: Masters of the State, Book One: Magisters",
        "discipline": "Obtenebration",
        "level": "basic",
        "challengeType": "mental",
        "bloodCost": "",
        "retestAbility": "Occult",
        "duration": "Until all nearby light sources are doused",
        "activation": "challenge",
        "active": false,
        "prerequisites": "Obtenebration (2), Obfuscate (1)"
      },
      "effects": [],
      "folder": null,
      "sort": 0,
      "flags": {},
      "_stats": {
        "systemId": "vtmlarp",
        "systemVersion": "0.1.0",
        "coreVersion": "12",
        "createdTime": null,
        "modifiedTime": null,
        "lastModifiedBy": null
      }
    },
    {
      "_id": "38a23797241245dc",
      "name": "Dark Steel",
      "type": "power",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A combination power blending Obtenebration and Potence. Where Arms of Ahriman lets a Lasombra summon tentacles of pure shadow to grip and strike, this bastardized variant grants those pseudopods far greater strength and endurance, catching Cainites used to the ordinary manifestation off guard. Each success summons one tentacle, emerging from any nearby patch of shadow (beneath furniture, from within the vampire's own cloak, and so on). Every tentacle is eight feet long and has Strength and Dexterity equal to twice the wielder's Obtenebration rating. The vampire may feed a tentacle additional Blood Points, one for one, raising its ratings further. A Dark Steel tentacle deals Strength+2 crushing damage, has six health levels of its own, and — like the wielder — takes extra harm from fire and sunlight.</p>",
        "source": "Libellus Sanguinis I: Masters of the State, Book One: Magisters",
        "discipline": "Obtenebration",
        "level": "intermediate",
        "challengeType": "physical",
        "bloodCost": "2 Blood Points, plus 1 per point of tentacle enhancement",
        "retestAbility": "Occult",
        "duration": "One scene or until dismissed",
        "activation": "challenge",
        "active": false,
        "prerequisites": "Obtenebration (3), Potence (3)"
      },
