{
  "name": "vtmlarp",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packs": "node tools/build-packs.mjs",
    "validate:packs": "node tools/validate-packs.mjs",
    "check:packs": "node tools/check-packs-current.mjs",
    "validate:manifest": "node tools/validate-manifest.mjs",
    "validate:templates": "node tools/validate-templates.mjs",
    "lint": "eslint scripts tools test *.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run lint && npm run test && npm run validate:manifest && npm run validate:templates && npm run validate:packs && npm run check:packs",
    "ci": "npm run check"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "eslint": "^9.39.5",
    "handlebars": "^4.7.9"
  }
}
