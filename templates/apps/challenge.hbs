<form class="vtmlarp-challenge flexcol">
  <p class="hint">For a Physical/Social/Mental Challenge, pick your opponent and gesture below - they'll get a private popup to choose their own gesture, and the result posts to chat once both sides are in. Each side's Traits Bid is always their full remaining pool of the matching Attribute category.</p>

  <label>Challenge Type
    <select name="challengeType">
      {{#each challengeTypes as |type|}}
      <option value="{{type}}">{{vtmCapitalize type}}</option>
      {{/each}}
    </select>
  </label>

  {{#if equipmentBonuses.length}}
  <fieldset>
    <legend>Equipment Bonuses (factor in manually)</legend>
    <ul class="equipment-bonus-list">
      {{#each equipmentBonuses as |b|}}
      <li>{{b}}</li>
      {{/each}}
    </ul>
  </fieldset>
  {{/if}}

  <div class="static-only" style="display:none;">
    <p class="hint">Static Challenge: no opposing throw - your Traits Bid must exceed the Difficulty (a tie is not enough) to succeed.</p>
    <label>Traits Bid <input type="number" name="traitsBid" value="1" min="0"></label>
    <label>Difficulty <input type="number" name="difficulty" value="1" min="1"></label>
  </div>

  <div class="rps-only">
    <p class="hint">Your Traits Bid (<span class="own-pool-hint"></span>) and your opponent's are pulled automatically from each side's current pool.</p>
    <label>Your Gesture
      <select name="gesture">
        {{#each gestures as |g|}}
        <option value="{{g}}">{{vtmCapitalize g}}</option>
        {{/each}}
      </select>
    </label>

    <label>Opponent
      <select name="opponentActorId">
        <option value="">— Select an opponent —</option>
        {{#each actorOptions as |a|}}
        <option value="{{a.id}}">{{a.name}}</option>
        {{/each}}
      </select>
    </label>
  </div>

  <label>Retest Used <input type="text" name="retest" placeholder="e.g. Willpower, Brawl Ability"></label>

  <button type="submit" class="vtm-submit"><i class="fas fa-bullhorn"></i> Send Challenge</button>
</form>
