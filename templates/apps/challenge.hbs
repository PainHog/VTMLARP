<form class="vtmlarp-challenge flexcol">
  <label>Resolution
    <select name="resolution">
      <option value="rps" selected>Rock-Paper-Scissors (MET default)</option>
      <option value="dice">d10 Dice Pool (V5 rules)</option>
    </select>
  </label>

  <!-- ============ RPS / static mode (the MET default) ============ -->
  <div class="mode-rps">
  <p class="hint">For a Physical/Social/Mental Challenge, pick your opponent and gesture below - they'll get a private popup to choose their own gesture, and the result posts to chat once both sides are in. Each side's Traits Bid is always their full remaining pool of the matching Attribute category.</p>

  {{#if prefill.powerName}}
  <p class="hint">Using: <strong>{{prefill.powerName}}</strong></p>
  {{/if}}

  <label>Challenge Type
    <select name="challengeType">
      {{#each challengeTypes as |type|}}
      <option value="{{type}}" {{#if (eq type ../prefill.challengeType)}}selected{{/if}}>{{vtmCapitalize type}}</option>
      {{/each}}
    </select>
  </label>

  {{#if equipmentBonuses.length}}
  <fieldset>
    <legend>Equipment Bonuses (factor in manually)</legend>
    <ul class="equipment-bonus-list">
      {{#each equipmentBonuses as |b|}}
      <li>{{b}}</li>
      {{/each}}
    </ul>
  </fieldset>
  {{/if}}

  <div class="static-only" style="display:none;">
    <p class="hint">Static Challenge: no opposing throw - your Traits Bid must exceed the Difficulty (a tie is not enough) to succeed.</p>
    <label>Traits Bid <input type="number" name="traitsBid" value="1" min="0"></label>
    <label>Difficulty <input type="number" name="difficulty" value="1" min="1"></label>
  </div>

  <div class="rps-only">
    <p class="hint">Your Traits Bid (<span class="own-pool-hint"></span>) and your opponent's are pulled automatically from each side's current pool.</p>
    <label>Your Gesture
      <select name="gesture">
        {{#each gestures as |g|}}
        <option value="{{g}}">{{vtmCapitalize g}}</option>
        {{/each}}
      </select>
    </label>

    <label>Opponent
      <select name="opponentActorId">
        <option value="">— Select an opponent —</option>
        {{#each actorOptions as |a|}}
        <option value="{{a.id}}" {{#if (eq a.id ../prefill.opponentActorId)}}selected{{/if}}>{{a.name}}</option>
        {{/each}}
      </select>
    </label>
    <p class="hint" style="flex-basis:100%;"><i class="fas fa-bullseye"></i> Mass effect? <strong>Target 2 or more tokens</strong> (Foundry targeting) before sending — one Challenge fires per target, each answered separately, and the dropdown is ignored.</p>
  </div>

  <label>Retest Used <input type="text" name="retest" value="{{prefill.retest}}" placeholder="e.g. Willpower, Brawl Ability"></label>

  <label>Bonus / Penalty Traits <input type="number" name="challengerMod" value="0" title="Extra Traits added to (or removed from) your bid - equipment, powers, situational modifiers, etc."></label>
  </div>

  <!-- ============ d10 dice-pool mode (V5 rules) ============ -->
  <div class="mode-dice" style="display:none;">
    <p class="hint">Roll a pool of d10s. The pool is your chosen Attribute's Trait total + the associated Ability's rating (+ any modifier). Each die showing <strong>6 or higher</strong> is a success; every pair of 10s counts as <strong>4</strong> successes (a critical). The result posts openly to chat.</p>

    <label>Attribute
      <select name="diceAttribute">
        {{#each attributes as |a|}}
        <option value="{{a.key}}">{{a.label}} ({{a.total}})</option>
        {{/each}}
      </select>
    </label>

    <label>Associated Ability
      <select name="diceAbility">
        <option value="">— none (0) —</option>
        {{#each abilities as |ab|}}
        <option value="{{ab.rating}}">{{ab.name}} ({{ab.rating}})</option>
        {{/each}}
      </select>
    </label>

    <label>Modifier <input type="number" name="diceMod" value="0" title="Extra dice added to (or removed from) the pool."></label>

    <label>Hunger <span class="hint" style="font-weight:normal;">(V5 flavor — this system has no Hunger stat, so set it by hand if you use it)</span>
      <input type="number" name="diceHunger" value="0" min="0" max="5" title="How many of the pool's dice are Hunger dice (messy criticals / bestial failures). Leave 0 if unused.">
    </label>

    <p class="hint dice-pool-preview">Dice pool: <strong><span class="dice-pool-total">0</span></strong></p>

    <label class="dice-opposed-toggle"><input type="checkbox" name="diceOpposed"> Opposed roll (compare successes against another pool)</label>

    <div class="dice-vs-difficulty">
      <label>Difficulty (successes needed) <input type="number" name="diceDifficulty" value="3" min="1"></label>
    </div>

    <div class="dice-vs-opposed" style="display:none;">
      <label>Opposing dice pool <input type="number" name="diceOppPool" value="0" min="0"></label>
      <label>Opposing Hunger <input type="number" name="diceOppHunger" value="0" min="0" max="5"></label>
      <p class="hint">Both pools are rolled here and the higher number of successes wins — dice are open, so rolling both sides on one client is fine.</p>
    </div>
  </div>

  <button type="submit" class="vtm-submit"><i class="fas fa-bullhorn"></i> <span class="vtm-submit-label">Send Challenge</span></button>
</form>
