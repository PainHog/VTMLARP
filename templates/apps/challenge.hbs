<form class="vtmlarp-challenge flexcol">
  <p class="hint">Throw Rock-Paper-Scissors face to face with your opponent as normal, then log the result here for the table's record.</p>

  <label>Challenge Type
    <select name="challengeType">
      {{#each challengeTypes as |type|}}
      <option value="{{type}}">{{vtmCapitalize type}}</option>
      {{/each}}
    </select>
  </label>

  <label>Traits Bid
    <input type="number" name="traitsBid" value="1" min="0">
  </label>

  {{#if fullBidEnabled}}
  <label><input type="checkbox" name="fullBid"> Full-Bid: use entire trait pool for this Challenge Type</label>
  <p class="hint">Remaining pools — Physical: {{pools.physical}}, Social: {{pools.social}}, Mental: {{pools.mental}}</p>
  {{/if}}

  {{#if equipmentBonuses.length}}
  <fieldset>
    <legend>Equipment Bonuses (factor in manually)</legend>
    <ul class="equipment-bonus-list">
      {{#each equipmentBonuses as |b|}}
      <li>{{b}}</li>
      {{/each}}
    </ul>
  </fieldset>
  {{/if}}

  <div class="static-only" style="display:none;">
    <p class="hint">Static Challenge: no opposing throw - your Traits Bid must exceed the Difficulty (a tie is not enough) to succeed.</p>
    <label>Difficulty <input type="number" name="difficulty" value="1" min="1"></label>
  </div>

  <div class="rps-only">
    <label>Your Gesture
      <select name="gesture">
        {{#each gestures as |g|}}
        <option value="{{g}}">{{vtmCapitalize g}}</option>
        {{/each}}
      </select>
    </label>

    <fieldset>
      <legend>Opponent (optional)</legend>
      <label>Name <input type="text" name="opponentName" placeholder="Opponent name"></label>
      <label>Their Gesture
        <select name="opponentGesture">
          <option value="">-</option>
          {{#each gestures as |g|}}
          <option value="{{g}}">{{vtmCapitalize g}}</option>
          {{/each}}
        </select>
      </label>
    </fieldset>
  </div>

  <label>Retest Used <input type="text" name="retest" placeholder="e.g. Willpower, Brawl Ability"></label>

  <button type="submit" class="vtm-submit"><i class="fas fa-bullhorn"></i> Post Result to Chat</button>
</form>
