<div class="vtmlarp-challenge-card vtmlarp-challenge-prompt">
  <div class="vtm-clash-header">
    <span>{{challengeType}} Challenge</span>
  </div>
  <p class="hint">
    <strong>{{challengerName}}</strong> has challenged
    <strong>{{#if opponentName}}{{opponentName}}{{else}}Opponent{{/if}}</strong>.
    Only {{opponentName}}'s player (or a GM) can respond below.
  </p>

  {{#if retest}}
  <p class="vtm-retest"><strong>Retest:</strong> {{retest}}</p>
  {{/if}}

  <div class="vtm-gesture-response-row">
    <select class="vtm-gesture-select">
      <option value="">— Choose your Gesture —</option>
      {{#each gestures as |g|}}
      <option value="{{g}}">{{vtmCapitalize g}}</option>
      {{/each}}
    </select>
    <button type="button" class="vtm-gesture-respond"><i class="fas fa-hand-rock"></i> Respond</button>
  </div>

  {{#if retest}}
  <div class="vtm-retest-block-row">
    <input type="text" class="vtm-retest-block-source" placeholder="Ability given up to cancel (e.g. Brawl)">
    <button type="button" class="vtm-retest-block-submit"><i class="fas fa-shield-halved"></i> Cancel Their Retest (give up an ability)</button>
  </div>
  <p class="hint">Instead of responding, you may cancel the retest outright by giving up a relevant ability (e.g. spend 1 Brawl to cancel a Dodge). Note the ability above; you win the challenge without a re-throw.</p>
  {{/if}}
</div>
