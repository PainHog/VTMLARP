<form class="vtmlarp-challenge flexcol">
  <p class="hint">{{challengerName}} has challenged {{#if opponentActorName}}{{opponentActorName}}{{else}}you{{/if}} to a {{challengeType}} Challenge. Choose your gesture - their throw stays hidden until you submit.</p>

  {{#if retest}}
  <fieldset class="block-retest">
    <legend>Retest Declared: {{retest}}</legend>
    <p class="hint">A retest can be blocked by an opponent who can match its conditions (e.g., Dodge blocking a Firearms retest). Blocking skips the throw entirely and ends the Challenge in your favor.</p>
    <label><input type="checkbox" name="block"> Block this retest</label>
    <label>With what <input type="text" name="blockSource" placeholder="e.g. Dodge"></label>
  </fieldset>
  {{/if}}

  <label>Your Gesture
    <select name="gesture">
      {{#each gestures as |g|}}
      <option value="{{g}}">{{vtmCapitalize g}}</option>
      {{/each}}
    </select>
  </label>

  <div class="flexrow challenge-response-buttons">
    <button type="button" class="vtm-random" title="Pick a random Rock/Paper/Scissors and throw"><i class="fas fa-dice"></i> Random</button>
    <button type="submit" class="vtm-submit"><i class="fas fa-bullhorn"></i> Throw</button>
  </div>
</form>
