<form class="vtmlarp sheet character-builder flexcol" autocomplete="off">
  <div class="builder-header">
    <span class="builder-stepname">Step 1</span>
    <span class="builder-freebie-live" title="Freebie XP spent / available. Available = 12 base + Flaws (max 7) + 2 if you take a Derangement.">Freebie XP: <span class="count count-freebies">0 / 12</span></span>
    <label class="check builder-orig"><input type="checkbox" name="useOriginal"> Original rules</label>
  </div>

  <!-- STEP: Concept -->
  <div class="builder-step" data-title="Concept">
    <div class="builder-toprow flexrow">
      <label class="wide">Name <input type="text" name="charname" placeholder="Character name"></label>
      <label>Generation
        <select name="generation">{{#each generations as |g|}}<option value="{{g}}" {{#if (eq g 13)}}selected{{/if}}>{{g}}th</option>{{/each}}</select>
      </label>
    </div>
    <div class="builder-toprow flexrow">
      <label>Clan <span class="sel-info-wrap"><select name="clan"><option value="">—</option>{{#each clans as |c|}}<option value="{{c}}" {{#if (eq c ../initialClan)}}selected{{/if}}>{{c}}</option>{{/each}}</select><i class="fas fa-circle-info sel-info" data-action="openInfoSel" data-kind="clan" data-for="clan" title="View this clan's compendium lore"></i></span></label>
      <label>Sect <span class="sel-info-wrap"><select name="sect"><option value="">—</option>{{#each sects as |s|}}<option value="{{s}}">{{s}}</option>{{/each}}</select><i class="fas fa-circle-info sel-info" data-action="openInfoSel" data-kind="sect" data-for="sect" title="View this sect's compendium lore"></i></span></label>
      <label>Path <span class="sel-info-wrap"><select name="path">{{#each paths as |p|}}<option value="{{p}}">{{p}}</option>{{/each}}</select><i class="fas fa-circle-info sel-info" data-action="openInfoSel" data-kind="path" data-for="path" title="View this path's compendium lore"></i></span></label>
    </div>
    <div class="builder-toprow flexrow">
      <label>Nature <select name="nature"><option value="">—</option>{{#each archetypes as |a|}}<option value="{{a}}">{{a}}</option>{{/each}}</select></label>
      <label>Demeanor <select name="demeanor"><option value="">—</option>{{#each archetypes as |a|}}<option value="{{a}}">{{a}}</option>{{/each}}</select></label>
    </div>
  </div>

  <!-- STEP: Attributes -->
  <div class="builder-step" data-title="Attributes">
    <h3>Attributes <span class="count count-attributes">0 / 15</span></h3>
    <p class="hint">Distribute 7 / 5 / 3 across the three categories (15 total). Priority is set automatically from the highest.</p>
    <div class="flexrow">
      <label>Physical <input type="number" name="phys" value="0" min="0"></label>
      <label>Social <input type="number" name="soc" value="0" min="0"></label>
      <label>Mental <input type="number" name="ment" value="0" min="0"></label>
    </div>
  </div>

  <!-- STEP: Abilities -->
  <div class="builder-step" data-title="Abilities">
    <h3>Abilities <span class="count count-abilities">0 / 11</span></h3>
    <p class="hint">Click an Ability to add it, then set its dots.</p>
    <div class="pick-list">
      {{#each abilities as |a|}}<a class="pick" data-action="pickAdd" data-kind="ability" data-name="{{a.name}}" {{#if a.info}}data-tooltip="{{a.info}}"{{/if}}>{{a.name}}{{#if a.uuid}} <i class="fas fa-circle-info pick-info" data-action="openInfo" data-uuid="{{a.uuid}}" title="View compendium entry"></i>{{/if}}</a>{{/each}}
    </div>
    <div class="rows-ability"></div>
    <template class="row-ability"><div class="builder-row flexrow">
      <input type="text" name="name" placeholder="Ability" class="wide">
      <input type="number" name="rating" value="1" min="0" max="10" class="tiny">
      <a data-action="removeRow" title="Remove"><i class="fas fa-times"></i></a>
    </div></template>
  </div>

  <!-- STEP: Disciplines -->
  <div class="builder-step" data-title="Disciplines">
    <h3>Disciplines <span class="count count-disciplines">0 / 5</span></h3>
    <p class="hint">Your clan's three in-clan Disciplines are added automatically when you pick a clan. Use the <i class="fas fa-right-left"></i> dropdown on any row to <strong>swap</strong> it for another Discipline before assigning dots, or click one below to add an extra. Your 5 free dots can raise a Discipline to <strong>3 max</strong>; going to 4 or 5 must be bought with Freebies (6 for the 4th dot, 9 for the 5th). Core powers up to the dots set are pulled onto the sheet in order on creation.</p>
    <div class="pick-list">
      {{#each disciplineList as |d|}}<a class="pick" data-action="pickAdd" data-kind="discipline" data-name="{{d.name}}" {{#if d.info}}data-tooltip="{{d.info}}"{{/if}}>{{d.name}}{{#if d.uuid}} <i class="fas fa-circle-info pick-info" data-action="openInfo" data-uuid="{{d.uuid}}" title="View compendium entry"></i>{{/if}}</a>{{/each}}
    </div>
    <div class="rows-discipline"></div>
    <template class="row-discipline"><div class="builder-row flexrow">
      <i class="fas fa-right-left disc-swap-icon" title="Swap this Discipline"></i>
      <select name="name" class="wide disc-select" title="Swap this Discipline">
        <option value="">— Discipline —</option>
        {{#each disciplineList as |d|}}<option value="{{d.name}}">{{d.name}}</option>{{/each}}
      </select>
      <i class="fas fa-circle-info sel-info" data-action="openInfoSel" data-kind="discipline" title="View this Discipline's compendium entry"></i>
      <input type="number" name="rating" value="0" min="0" max="5" class="tiny">
      <a data-action="removeRow" title="Remove"><i class="fas fa-times"></i></a>
    </div></template>
  </div>

  <!-- STEP: Backgrounds -->
  <div class="builder-step" data-title="Backgrounds">
    <h3>Backgrounds <span class="count count-backgrounds">0 / 5</span></h3>
    <p class="hint">Click a Background to add it, then set its dots.</p>
    <div class="pick-list">
      {{#each backgrounds as |b|}}<a class="pick" data-action="pickAdd" data-kind="background" data-name="{{b.name}}" {{#if b.info}}data-tooltip="{{b.info}}"{{/if}}>{{b.name}}{{#if b.uuid}} <i class="fas fa-circle-info pick-info" data-action="openInfo" data-uuid="{{b.uuid}}" title="View compendium entry"></i>{{/if}}</a>{{/each}}
    </div>
    <div class="rows-background"></div>
    <template class="row-background"><div class="builder-row flexrow">
      <input type="text" name="name" placeholder="Background" class="wide">
      <input type="number" name="rating" value="1" min="0" max="5" class="tiny">
      <a data-action="removeRow"><i class="fas fa-times"></i></a>
    </div></template>
  </div>

  <!-- STEP: Virtues -->
  <div class="builder-step" data-title="Virtues & Willpower">
    <h3>Virtues <span class="count count-virtues">0 / 10</span></h3>
    <p class="hint">10 points across the three Virtues (each starts with 1).</p>
    <div class="flexrow">
      <label>Conscience / Conviction <input type="number" name="conscience" value="1" min="0" max="5"></label>
      <label>Self-Control / Instinct <input type="number" name="selfcontrol" value="1" min="0" max="5"></label>
      <label>Courage <input type="number" name="courage" value="1" min="0" max="5"></label>
    </div>
    <p class="hint">Starting Willpower (by Generation): <span class="count count-willpower">2</span></p>
  </div>

  <!-- STEP: Merits & Flaws -->
  <div class="builder-step" data-title="Merits, Flaws & Derangement">
    <h3>Merits &amp; Flaws</h3>
    <p class="hint">Click to add. Flaws grant Freebies (max 7); Merits cost Freebies.</p>
    <div class="pick-columns flexrow">
      <div class="pick-col">
        <div class="pick-col-title">Merits</div>
        <div class="pick-list">{{#each merits as |m|}}<a class="pick" data-action="pickAdd" data-kind="meritflaw" data-name="{{m.name}}" data-type="merit" data-cost="{{m.cost}}" {{#if m.info}}data-tooltip="{{m.info}}"{{/if}}>{{m.name}} ({{m.cost}}){{#if m.uuid}} <i class="fas fa-circle-info pick-info" data-action="openInfo" data-uuid="{{m.uuid}}" title="View compendium entry"></i>{{/if}}</a>{{/each}}</div>
      </div>
      <div class="pick-col">
        <div class="pick-col-title">Flaws</div>
        <div class="pick-list">{{#each flaws as |f|}}<a class="pick" data-action="pickAdd" data-kind="meritflaw" data-name="{{f.name}}" data-type="flaw" data-cost="{{f.cost}}" {{#if f.info}}data-tooltip="{{f.info}}"{{/if}}>{{f.name}} ({{f.cost}}){{#if f.uuid}} <i class="fas fa-circle-info pick-info" data-action="openInfo" data-uuid="{{f.uuid}}" title="View compendium entry"></i>{{/if}}</a>{{/each}}</div>
      </div>
    </div>
    <div class="rows-meritflaw"></div>
    <template class="row-meritflaw"><div class="builder-row flexrow">
      <select name="type"><option value="merit">Merit</option><option value="flaw">Flaw</option></select>
      <input type="text" name="name" placeholder="Name" class="wide">
      <input type="number" name="cost" value="1" min="0" max="7" class="tiny">
      <a data-action="removeRow"><i class="fas fa-times"></i></a>
    </div></template>
    <label>Derangement (+2 Freebies)
      <span class="sel-info-wrap"><select name="derangement"><option value="">— none —</option>{{#each derangements as |d|}}<option value="{{d}}">{{d}}</option>{{/each}}</select><i class="fas fa-circle-info sel-info" data-action="openInfoSel" data-kind="derangement" data-for="derangement" title="View this Derangement's compendium entry"></i></span>
    </label>
  </div>

  <!-- STEP: Review -->
  <div class="builder-step" data-title="Review & Freebies">
    <h3>Review</h3>
    <p class="hint">Every area's spend, and your Freebie total. Anything you put over an area's allotment (plus Merits) is paid from Freebies. <strong>To spend your Freebie XP</strong>, use <em>Back</em> to return to any panel and raise a trait past its base allotment — the Freebie XP counter in the header updates live as you go back and forth. Take Flaws and a Derangement first to see your full Freebie total.</p>
    <ul class="builder-review">
      <li>Attributes: <span class="count count-attributes">0 / 15</span></li>
      <li>Abilities: <span class="count count-abilities">0 / 11</span></li>
      <li>Disciplines: <span class="count count-disciplines">0 / 5</span></li>
      <li>Backgrounds: <span class="count count-backgrounds">0 / 5</span></li>
      <li>Virtues: <span class="count count-virtues">0 / 10</span></li>
      <li><strong>Freebies: <span class="count count-freebies">0 / 12</span></strong></li>
    </ul>
    <p class="hint">Click <strong>Add Character</strong> to build the sheet.</p>
  </div>

  <div class="builder-nav flexrow">
    <button type="button" class="builder-back" data-action="back"><i class="fas fa-arrow-left"></i> Back</button>
    <button type="button" class="builder-next" data-action="next">Next <i class="fas fa-arrow-right"></i></button>
    <button type="button" class="builder-create hidden" data-action="createCharacter"><i class="fas fa-user-plus"></i> Add Character</button>
  </div>
</form>
