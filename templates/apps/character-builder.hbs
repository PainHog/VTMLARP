<form class="vtmlarp sheet character-builder flexcol" autocomplete="off">
  <datalist id="bld-abilities">{{#each abilityNames as |n|}}<option value="{{n}}">{{/each}}</datalist>
  <datalist id="bld-disciplines">{{#each disciplineNames as |n|}}<option value="{{n}}">{{/each}}</datalist>
  <datalist id="bld-backgrounds">{{#each backgroundNames as |n|}}<option value="{{n}}">{{/each}}</datalist>
  <datalist id="bld-meritflaws">{{#each meritFlawNames as |n|}}<option value="{{n}}">{{/each}}</datalist>
  <p class="hint">Fill in each section. The counters show points spent vs. your allotment (they turn red if over). When you're done, <strong>Create Character</strong> builds the sheet.</p>

  <div class="builder-toprow flexrow">
    <label class="wide">Name <input type="text" name="charname" placeholder="Character name"></label>
    <label>Generation
      <select name="generation">{{#each generations as |g|}}<option value="{{g}}" {{#if (eq g 13)}}selected{{/if}}>{{g}}th</option>{{/each}}</select>
    </label>
  </div>

  <div class="builder-toprow flexrow">
    <label>Clan <select name="clan"><option value="">—</option>{{#each clans as |c|}}<option value="{{c}}">{{c}}</option>{{/each}}</select></label>
    <label>Sect <select name="sect"><option value="">—</option>{{#each sects as |s|}}<option value="{{s}}">{{s}}</option>{{/each}}</select></label>
    <label>Path <select name="path">{{#each paths as |p|}}<option value="{{p}}">{{p}}</option>{{/each}}</select></label>
  </div>
  <div class="builder-toprow flexrow">
    <label>Nature <select name="nature"><option value="">—</option>{{#each archetypes as |a|}}<option value="{{a}}">{{a}}</option>{{/each}}</select></label>
    <label>Demeanor <select name="demeanor"><option value="">—</option>{{#each archetypes as |a|}}<option value="{{a}}">{{a}}</option>{{/each}}</select></label>
    <label class="check"><input type="checkbox" name="useOriginal"> Original rules</label>
  </div>

  <section class="builder-section">
    <h3>Attributes <span class="count count-attributes">0 / 15</span></h3>
    <p class="hint">Distribute 7 / 5 / 3 across the three categories (15 total). Priority is set automatically from the highest.</p>
    <div class="flexrow">
      <label>Physical <input type="number" name="phys" value="0" min="0"></label>
      <label>Social <input type="number" name="soc" value="0" min="0"></label>
      <label>Mental <input type="number" name="ment" value="0" min="0"></label>
    </div>
  </section>

  <section class="builder-section">
    <h3>Abilities <span class="count count-abilities">0 / 11</span>
      <a class="builder-add" data-action="addRow" data-kind="ability"><i class="fas fa-plus"></i> Add</a>
    </h3>
    <div class="rows-ability"></div>
    <template class="row-ability"><div class="builder-row flexrow">
      <select name="category"><option value="talent">Talent</option><option value="skill">Skill</option><option value="knowledge">Knowledge</option></select>
      <input type="text" name="name" placeholder="Ability" class="wide" list="bld-abilities">
      <input type="number" name="rating" value="1" min="0" max="10" class="tiny">
      <a data-action="removeRow"><i class="fas fa-times"></i></a>
    </div></template>
  </section>

  <section class="builder-section">
    <h3>Disciplines <span class="count count-disciplines">0 / 5</span>
      <a class="builder-add" data-action="addRow" data-kind="discipline"><i class="fas fa-plus"></i> Add</a>
    </h3>
    <p class="hint">Max 3 dots in any one Discipline at start.</p>
    <div class="rows-discipline"></div>
    <template class="row-discipline"><div class="builder-row flexrow">
      <input type="text" name="name" placeholder="Discipline (e.g. Potence)" class="wide" list="bld-disciplines">
      <input type="number" name="rating" value="1" min="0" max="5" class="tiny">
      <a data-action="removeRow"><i class="fas fa-times"></i></a>
    </div></template>
  </section>

  <section class="builder-section">
    <h3>Backgrounds <span class="count count-backgrounds">0 / 5</span>
      <a class="builder-add" data-action="addRow" data-kind="background"><i class="fas fa-plus"></i> Add</a>
    </h3>
    <div class="rows-background"></div>
    <template class="row-background"><div class="builder-row flexrow">
      <input type="text" name="name" placeholder="Background (e.g. Resources)" class="wide" list="bld-backgrounds">
      <input type="number" name="rating" value="1" min="0" max="5" class="tiny">
      <a data-action="removeRow"><i class="fas fa-times"></i></a>
    </div></template>
  </section>

  <section class="builder-section">
    <h3>Virtues <span class="count count-virtues">0 / 10</span></h3>
    <p class="hint">10 points across the three Virtues (each starts with 1).</p>
    <div class="flexrow">
      <label>Conscience / Conviction <input type="number" name="conscience" value="1" min="0" max="5"></label>
      <label>Self-Control / Instinct <input type="number" name="selfcontrol" value="1" min="0" max="5"></label>
      <label>Courage <input type="number" name="courage" value="1" min="0" max="5"></label>
    </div>
    <p class="hint">Starting Willpower (by Generation): <span class="count count-willpower">2</span></p>
  </section>

  <section class="builder-section">
    <h3>Merits &amp; Flaws
      <a class="builder-add" data-action="addRow" data-kind="meritflaw"><i class="fas fa-plus"></i> Add</a>
    </h3>
    <div class="rows-meritflaw"></div>
    <template class="row-meritflaw"><div class="builder-row flexrow">
      <select name="type"><option value="merit">Merit</option><option value="flaw">Flaw</option></select>
      <input type="text" name="name" placeholder="Name" class="wide" list="bld-meritflaws">
      <input type="number" name="cost" value="1" min="0" max="7" class="tiny" title="Merit cost or Flaw value">
      <a data-action="removeRow"><i class="fas fa-times"></i></a>
    </div></template>
    <label class="check"><input type="checkbox" name="derangement"> Took a Derangement (+2 Freebies)</label>
  </section>

  <div class="builder-freebies">Freebies: <span class="count count-freebies">0 / 12</span></div>
  <button type="button" class="builder-create" data-action="createCharacter"><i class="fas fa-user-plus"></i> Create Character</button>
</form>
