<div class="vtmlarp clan-picker flexrow">
  <aside class="clan-rail">
    <div class="clan-search-row">
      <input type="text" name="clan-search" value="{{query}}" placeholder="Try “assassin”, “artist”, “necromancer”…" autocomplete="off">
      {{#if hasQuery}}<a data-action="clearSearch" title="Clear search"><i class="fas fa-times"></i></a>{{/if}}
    </div>
    {{#if hasQuery}}
    <p class="hint clan-search-count">{{count}} match{{#unless (eq count 1)}}es{{/unless}} for “{{query}}”.</p>
    {{/if}}
    <ul class="clan-list">
      {{#each list as |c|}}
      <li>
        <a data-action="jump" data-index="{{@index}}" class="clan-list-item {{#if c.active}}is-active{{/if}} {{#unless c.core}}is-bloodline{{/unless}}">
          <span class="clan-list-name">{{c.name}}</span>
          {{#if c.nickname}}<span class="clan-list-nick">{{c.nickname}}</span>{{/if}}
        </a>
      </li>
      {{else}}
      <li class="hint">No clan matches that. Try a different word, or clear the search.</li>
      {{/each}}
    </ul>
  </aside>

  <section class="clan-card flexcol">
    {{#with clan}}
    <header class="clan-card-head">
      <div class="clan-card-label">Clan</div>
      <h2 class="clan-card-name">{{name}}</h2>
      {{#if nickname}}<div class="clan-card-nick">{{nickname}}</div>{{/if}}
    </header>

    {{#if tags.length}}
    <div class="clan-card-field">
      <span class="clan-card-label">Playstyle</span>
      <div class="clan-card-tags">
        {{#each tags as |t|}}<span class="clan-tag">{{t}}</span>{{/each}}
      </div>
    </div>
    {{/if}}

    <div class="clan-card-field">
      <span class="clan-card-label">About</span>
      <p class="clan-card-blurb">{{blurb}}</p>
    </div>

    <div class="clan-card-field clan-card-disc">
      <span class="clan-card-label">Disciplines</span>
      {{#if clanless}}
      <p class="hint">No fixed Disciplines — a {{name}} character can learn any Disciplines you choose in the Character Builder.</p>
      {{else}}
      <ul>
        {{#each disciplines as |d|}}
        <li>
          {{#if d.uuid}}<a data-action="discipline" data-uuid="{{d.uuid}}" class="disc-link" title="Open {{d.name}} in the compendium"><strong>{{d.name}}</strong></a>{{else}}<strong>{{d.name}}</strong>{{/if}}
          — {{d.blurb}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </div>

    <div class="clan-card-actions flexrow">
      <button type="button" class="select-clan" data-action="selectClan" data-name="{{name}}"><i class="fas fa-user-plus"></i> Select Clan</button>
      <button type="button" data-action="lore" data-name="{{name}}"><i class="fas fa-book-open"></i> Read full lore</button>
    </div>
    <p class="hint clan-alt-note">“Select Clan” opens the Character Builder with {{name}} set and its Disciplines seeded. Antitribu, revenant, and Dark Ages variants live in the Clans &amp; Bloodlines compendiums — search a keyword above to find them.</p>
    {{/with}}

    <footer class="clan-card-nav flexrow">
      <button type="button" data-action="prev"><i class="fas fa-chevron-left"></i> Previous</button>
      <span class="clan-card-count">{{position}} / {{count}}</span>
      <button type="button" data-action="next">Next <i class="fas fa-chevron-right"></i></button>
    </footer>
  </section>
</div>
