<div class="vtmlarp-challenge-card">
  <div class="vtm-clash-header">
    <span>{{challengeType}} Challenge</span>
    {{#unless isStatic}}<span>{{traitsBid}} vs {{opponentTraitsBid}} Traits Bid{{#if fullBid}} (Full-Bid){{/if}}</span>{{/unless}}
  </div>

  {{#if isStatic}}
  <div class="vtm-static-test">
    <span class="vtm-combatant-name">{{actorName}}</span>
    <span class="vtm-static-vs">{{traitsBid}} vs Difficulty {{difficulty}}</span>
  </div>
  {{else}}
  <div class="vtm-clash">
    <div class="vtm-combatant">
      <span class="vtm-combatant-name">{{actorName}} ({{traitsBid}})</span>
      <span class="vtm-gesture vtm-gesture-left">{{vtmGestureEmoji gesture}}</span>
    </div>
    <span class="vtm-vs">VS</span>
    <div class="vtm-combatant">
      <span class="vtm-combatant-name">{{#if opponentName}}{{opponentName}}{{else}}Opponent{{/if}} ({{opponentTraitsBid}})</span>
      {{#if opponentGesture}}
      <span class="vtm-gesture vtm-gesture-right">{{vtmGestureEmoji opponentGesture}}</span>
      {{else}}
      <span class="vtm-gesture vtm-gesture-right vtm-gesture-unknown">?</span>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if result}}
  <div class="vtm-result-banner result-{{result}}">{{resultLabel}}</div>
  {{/if}}

  {{#if retest}}
  <p class="vtm-retest"><strong>Retest:</strong> {{retest}}</p>
  {{/if}}
</div>
