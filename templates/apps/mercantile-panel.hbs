<form class="vtmlarp mercantile-panel flexcol" autocomplete="off">
  <div class="merc-toolbar flexrow">
    <button type="button" data-action="addShop"><i class="fas fa-store"></i> New Shop</button>
    <button type="button" data-action="openBrowser"><i class="fas fa-eye"></i> Preview shops (player view)</button>
    <span class="hint">Drag a Gear item from a compendium onto a shop to add it as stock.</span>
  </div>

  {{#each shops as |shop|}}
  <fieldset class="merc-shop" data-shop-id="{{shop.id}}">
    <legend>
      <input type="text" data-field="name" data-shop-id="{{shop.id}}" value="{{shop.name}}" class="merc-shop-name">
      <label class="merc-open {{#if shop.open}}is-open{{/if}}">
        <input type="checkbox" data-field="open" data-shop-id="{{shop.id}}" {{#if shop.open}}checked{{/if}}>
        {{#if shop.open}}OPEN{{else}}closed{{/if}}
      </label>
      <a data-action="deleteShop" data-shop-id="{{shop.id}}" title="Delete shop"><i class="fas fa-trash"></i></a>
    </legend>

    <div class="flexrow">
      <label class="wide">Keeper <input type="text" data-field="keeper" data-shop-id="{{shop.id}}" value="{{shop.keeper}}" placeholder="e.g. the Blades street gang"></label>
    </div>
    <label>Notes <input type="text" data-field="notes" data-shop-id="{{shop.id}}" value="{{shop.notes}}" placeholder="Flavor / where it is / when it appears"></label>

    <table class="merc-stock">
      <thead><tr><th>Item</th><th>Type</th><th>Price</th><th>Qty</th><th title="Accept money">$</th><th title="Accept Boon">Boon</th><th title="Accept barter">Barter</th><th></th></tr></thead>
      <tbody>
        {{#each shop.stock as |item|}}
        <tr data-item-id="{{item.id}}">
          <td><input type="text" data-field="name" data-shop-id="{{shop.id}}" data-item-id="{{item.id}}" value="{{item.name}}"></td>
          <td><select data-field="category" data-shop-id="{{shop.id}}" data-item-id="{{item.id}}">{{#each ../../categories as |c|}}<option value="{{c}}" {{#if (eq item.category c)}}selected{{/if}}>{{c}}</option>{{/each}}</select></td>
          <td><input type="number" data-field="price" data-shop-id="{{shop.id}}" data-item-id="{{item.id}}" value="{{item.price}}" min="0" class="tiny"></td>
          <td><input type="number" data-field="qty" data-shop-id="{{shop.id}}" data-item-id="{{item.id}}" value="{{item.qty}}" title="-1 = unlimited" class="tiny"></td>
          <td><input type="checkbox" data-field="money" data-shop-id="{{shop.id}}" data-item-id="{{item.id}}" {{#if item.money}}checked{{/if}}></td>
          <td><input type="checkbox" data-field="boon" data-shop-id="{{shop.id}}" data-item-id="{{item.id}}" {{#if item.boon}}checked{{/if}}></td>
          <td><input type="checkbox" data-field="barter" data-shop-id="{{shop.id}}" data-item-id="{{item.id}}" {{#if item.barter}}checked{{/if}}></td>
          <td><a data-action="deleteItem" data-shop-id="{{shop.id}}" data-item-id="{{item.id}}" title="Remove"><i class="fas fa-times"></i></a></td>
        </tr>
        <tr class="merc-desc-row"><td colspan="8"><input type="text" data-field="description" data-shop-id="{{shop.id}}" data-item-id="{{item.id}}" value="{{item.description}}" placeholder="Item description (shown to buyers)"></td></tr>
        {{else}}
        <tr><td colspan="8" class="hint">No stock yet — click + or drag a Gear item here.</td></tr>
        {{/each}}
      </tbody>
    </table>
    <div class="flexrow" style="gap:6px;">
      <button type="button" data-action="createItem" data-shop-id="{{shop.id}}"><i class="fas fa-wand-magic-sparkles"></i> Create Item…</button>
      <button type="button" data-action="addItem" data-shop-id="{{shop.id}}" title="Add a blank row to edit inline"><i class="fas fa-plus"></i> Quick add</button>
    </div>
  </fieldset>
  {{else}}
  <p class="hint">No shops yet. Click <strong>New Shop</strong> to create one — a street-gang fence, a fixer, a pop-up magical merchant — then toggle it OPEN when it's available to players.</p>
  {{/each}}
</form>
