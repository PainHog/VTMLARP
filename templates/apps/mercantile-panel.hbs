<div class="vtmlarp mercantile-panel flexcol" autocomplete="off">
  <div class="merc-toolbar flexrow">
    <button type="button" data-action="addShop"><i class="fas fa-store"></i> New Shop</button>
    <button type="button" data-action="openBrowser"><i class="fas fa-eye"></i> Preview (player view)</button>
  </div>
  <p class="hint">Shops are Actors — edit one to manage its stock, drag it into a compendium to save it for reuse, or drag a saved shop back in. Toggle a shop OPEN to make it available to players.</p>

  <ul class="merc-shop-list">
    {{#each shops as |shop|}}
    <li class="merc-shop-row flexrow" data-shop-id="{{shop.id}}">
      <a class="merc-open-toggle {{#if shop.open}}is-open{{/if}}" data-action="toggleOpen" data-shop-id="{{shop.id}}" title="Toggle open/closed">
        <i class="fas {{#if shop.open}}fa-lock-open{{else}}fa-lock{{/if}}"></i> {{#if shop.open}}OPEN{{else}}closed{{/if}}
      </a>
      <span class="merc-shop-name">{{shop.name}}{{#if shop.keeper}} <span class="hint">— {{shop.keeper}}</span>{{/if}}</span>
      <span class="hint merc-shop-count">{{shop.count}} item{{#unless (eq shop.count 1)}}s{{/unless}}</span>
      <a data-action="editShop" data-shop-id="{{shop.id}}" title="Edit stock"><i class="fas fa-pen-to-square"></i></a>
      <a data-action="deleteShop" data-shop-id="{{shop.id}}" title="Delete shop"><i class="fas fa-trash"></i></a>
    </li>
    {{else}}
    <li class="hint">No shops yet. Click <strong>New Shop</strong> to create one — a street-gang fence, a fixer, a pop-up magical merchant — then open it to add stock and toggle it OPEN.</li>
    {{/each}}
  </ul>
</div>
