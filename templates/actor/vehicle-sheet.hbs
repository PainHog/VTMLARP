<form class="{{cssClass}} flexcol" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}">
    <div class="header-fields flexcol">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Vehicle Name">
      <div class="flexrow header-grid">
        <label>Seats <input type="number" name="system.seats" value="{{system.seats}}" min="0"></label>
        <label>Grid Width (squares) <input type="number" name="system.gridWidth" value="{{system.gridWidth}}" min="1"></label>
        <label>Grid Height (squares) <input type="number" name="system.gridHeight" value="{{system.gridHeight}}" min="1"></label>
      </div>
      <p class="hint">
        Current token size: {{tokenWidth}}x{{tokenHeight}} squares.
        <a class="apply-grid-size"><i class="fas fa-arrows-up-down-left-right"></i> Apply Grid Width/Height above to token size</a>
      </p>
      <label>Durability / Damage Track <input type="text" name="system.durability" value="{{system.durability}}" placeholder="e.g. 3 boxes: Undamaged/Damaged/Wrecked"></label>
      <label>Source <input type="text" name="system.source" value="{{system.source}}" placeholder="e.g. Storyteller-created"></label>
    </div>
  </header>

  <section class="sheet-body">
    <h3>Description</h3>
    <prose-mirror name="system.description" {{#unless owner}}disabled{{/unless}} toggled button>{{{system.description}}}</prose-mirror>
    <h3>Notes</h3>
    <prose-mirror name="system.notes" {{#unless owner}}disabled{{/unless}} toggled button>{{{system.notes}}}</prose-mirror>
  </section>
</form>
