<form class="{{cssClass}} flexcol" autocomplete="off">

  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}">
    <div class="header-fields flexcol">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Character Name">
      <div class="flexrow header-grid">
        <label>Clan
          <span class="flexrow dropdown-with-lore">
            <select name="system.clan">
              <option value="">—</option>
              {{#each CLAN_OPTIONS as |c|}}
              <option value="{{c}}" {{#if (eq ../system.clan c)}}selected{{/if}}>{{c}}</option>
              {{/each}}
            </select>
            <a class="open-lore" data-pack="{{clanLoreEntry.pack}}" data-name="{{clanLoreEntry.name}}" title="Open {{#if clanLoreEntry.name}}{{clanLoreEntry.name}}{{else}}Clan{{/if}} lore"><i class="fas fa-book"></i></a>
          </span>
        </label>
        <label>Bloodline <input type="text" name="system.bloodline" value="{{system.bloodline}}" placeholder="e.g. Antitribu, Caitiff"></label>
        <label>Sect
          <span class="flexrow dropdown-with-lore">
            <select name="system.sect">
              <option value="">—</option>
              {{#each SECT_OPTIONS as |s|}}
              <option value="{{s}}" {{#if (eq ../system.sect s)}}selected{{/if}}>{{s}}</option>
              {{/each}}
            </select>
            <a class="open-lore" data-pack="{{sectLoreEntry.pack}}" data-name="{{sectLoreEntry.name}}" title="Open {{#if sectLoreEntry.name}}{{sectLoreEntry.name}}{{else}}Sect{{/if}} lore"><i class="fas fa-book"></i></a>
          </span>
        </label>
        <label>Generation
          <select name="system.generation">
            {{#each GENERATION_OPTIONS as |g|}}
            <option value="{{g}}" {{#if (eq ../system.generation g)}}selected{{/if}}>{{g}}th</option>
            {{/each}}
          </select>
        </label>
        <label>Nature
          <span class="flexrow dropdown-with-lore">
            <select name="system.nature">
              <option value="">—</option>
              {{#each ARCHETYPE_OPTIONS as |a|}}
              <option value="{{a}}" {{#if (eq ../system.nature a)}}selected{{/if}}>{{a}}</option>
              {{/each}}
            </select>
            {{#if archetypeLoreEntry}}
            <a class="open-lore" data-pack="{{archetypeLoreEntry.pack}}" data-name="{{archetypeLoreEntry.name}}" title="Open Archetypes lore"><i class="fas fa-book"></i></a>
            {{/if}}
          </span>
        </label>
        <label>Demeanor
          <span class="flexrow dropdown-with-lore">
            <select name="system.demeanor">
              <option value="">—</option>
              {{#each ARCHETYPE_OPTIONS as |a|}}
              <option value="{{a}}" {{#if (eq ../system.demeanor a)}}selected{{/if}}>{{a}}</option>
              {{/each}}
            </select>
            {{#if archetypeLoreEntry}}
            <a class="open-lore" data-pack="{{archetypeLoreEntry.pack}}" data-name="{{archetypeLoreEntry.name}}" title="Open Archetypes lore"><i class="fas fa-book"></i></a>
            {{/if}}
          </span>
        </label>
        <label>Title <input type="text" name="system.title" value="{{system.title}}"></label>
        <label>Coterie <input type="text" name="system.coterie" value="{{system.coterie}}" placeholder="Coterie/pack name"></label>
        {{#unless isCharacter}}
        <label>NPC Type
          <select name="system.npcType">
            {{#each NPC_TYPE_OPTIONS as |t|}}
            <option value="{{t}}" {{#if (eq ../system.npcType t)}}selected{{/if}}>{{vtmCapitalize t}}</option>
            {{/each}}
          </select>
        </label>
        {{/unless}}
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item {{#if tabs.main.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="main">Main</a>
    <a class="item {{#if tabs.attributes.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="attributes">Attributes</a>
    <a class="item {{#if tabs.abilities.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="abilities">Abilities</a>
    <a class="item {{#if tabs.powers.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="powers">Disciplines &amp; Powers</a>
    <a class="item {{#if tabs.backgrounds.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="backgrounds">Backgrounds</a>
    <a class="item {{#if tabs.meritsflaws.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="meritsflaws">Merits &amp; Flaws</a>
    <a class="item {{#if tabs.gear.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="gear">Gear</a>
    <a class="item {{#if tabs.social.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="social">Social</a>
    <a class="item {{#if tabs.bio.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="bio">Biography</a>
  </nav>

  <section class="sheet-body">

    <div class="tab {{#if tabs.main.active}}active{{/if}}" data-group="primary" data-tab="main">
      <div class="pools flexrow">
        <div class="pool">
          <label>Willpower</label>
          <input type="number" name="system.willpower.value" value="{{system.willpower.value}}">
          / <input type="number" name="system.willpower.max" value="{{system.willpower.max}}">
        </div>
        <div class="pool">
          <label>Blood</label>
          <input type="number" name="system.blood.value" value="{{system.blood.value}}">
          / <input type="number" name="system.blood.max" value="{{system.blood.max}}">
          (per turn <input type="number" name="system.blood.perTurn" value="{{system.blood.perTurn}}" class="tiny">)
        </div>
        <div class="pool">
          <label>Path Rating</label>
          <input type="number" name="system.morality.rating" value="{{system.morality.rating}}">
          <select name="system.morality.path" class="tiny">
            {{#each PATH_OPTIONS as |p|}}
            <option value="{{p}}" {{#if (eq ../system.morality.path p)}}selected{{/if}}>{{p}}</option>
            {{/each}}
          </select>
          {{#if pathLoreEntry}}
          <a class="open-lore" data-pack="{{pathLoreEntry.pack}}" data-name="{{pathLoreEntry.name}}" title="Open {{pathLoreEntry.name}} lore"><i class="fas fa-book"></i></a>
          {{/if}}
        </div>
        <div class="pool">
          <label>Experience</label>
          <input type="number" name="system.experience.value" value="{{system.experience.value}}"
            title="Ongoing: earned after each session, spent on new Attributes/Abilities/Backgrounds/Disciplines.">
          <span class="hint xp-spent-hint">({{xpSpent}} spent of {{system.experience.total}} earned)</span>
          {{#if isGM}}
          <a class="award-xp" title="Award Experience (adds to both current and lifetime total)"><i class="fas fa-star"></i></a>
          {{/if}}
        </div>
      </div>

      {{#if generationInfo}}
      <p class="hint generation-reference">
        Gen {{system.generation}} reference — Blood {{generationInfo.bloodMax}}/{{generationInfo.bloodPerTurn}} per turn,
        Willpower {{generationInfo.willpowerStart}}/{{generationInfo.willpowerMax}},
        Max Traits {{generationInfo.maxTraits}}, Max Abilities {{generationInfo.maxAbilities}}
        <a class="apply-generation" title="Set Blood/Willpower max from this Generation (clamps current values down if needed)"><i class="fas fa-sync"></i> Apply to Blood/Willpower</a>
      </p>
      {{/if}}

      <div class="virtues flexrow">
        <div class="virtue">
          <label>Conscience/Conviction
            <a class="open-lore" data-pack="{{virtuesLoreEntry.pack}}" data-name="{{virtuesLoreEntry.name}}" title="Open Virtues lore"><i class="fas fa-book"></i></a>
          </label>
          <input type="number" name="system.virtues.conscienceConviction.rating" value="{{system.virtues.conscienceConviction.rating}}">
        </div>
        <div class="virtue">
          <label>Self-Control/Instinct
            <a class="open-lore" data-pack="{{virtuesLoreEntry.pack}}" data-name="{{virtuesLoreEntry.name}}" title="Open Virtues lore"><i class="fas fa-book"></i></a>
          </label>
          <input type="number" name="system.virtues.selfControlInstinct.rating" value="{{system.virtues.selfControlInstinct.rating}}">
        </div>
        <div class="virtue">
          <label>Courage
            <a class="open-lore" data-pack="{{virtuesLoreEntry.pack}}" data-name="{{virtuesLoreEntry.name}}" title="Open Virtues lore"><i class="fas fa-book"></i></a>
          </label>
          <input type="number" name="system.virtues.courage.rating" value="{{system.virtues.courage.rating}}">
        </div>
      </div>

      <h3>Health
        <span class="hint">Click to take damage. Shift-click to heal a bashing/lethal box by spending 1 Blood.</span>
        <a class="health-level-add" title="Add a bonus Healthy level (e.g. from basic Fortitude)"><i class="fas fa-plus"></i></a>
        <a class="health-level-remove" title="Remove the last bonus Healthy level"><i class="fas fa-minus"></i></a>
      </h3>
      <div class="health-track flexrow">
        {{#each healthLevels as |level|}}
        <div class="health-box state-{{level.state}} {{#if level.bonus}}health-box-bonus{{/if}}"
          data-level="{{level.key}}" {{#if level.bonus}}data-bonus-index="{{level.bonusIndex}}"{{/if}}
          title="{{level.label}} ({{level.state}}) - click to cycle, shift-click to heal with Blood">
          <span class="label">{{level.label}}</span>
          <span class="state">{{level.state}}</span>
        </div>
        {{/each}}
      </div>

      <div class="main-actions flexrow">
        <button type="button" class="open-challenge"><i class="fas fa-hand-rock"></i> Resolve Challenge</button>
        <button type="button" class="open-frenzy"><i class="fas fa-burst"></i> Frenzy / Rötschreck</button>
        <button type="button" class="open-vaulderie"><i class="fas fa-tint"></i> Vaulderie</button>
        <button type="button" class="open-session-log"><i class="fas fa-scroll"></i> Session Log</button>
      </div>

    </div>

    <div class="tab {{#if tabs.attributes.active}}active{{/if}}" data-group="primary" data-tab="attributes">
      {{#each system.attributes as |category key|}}
      <div class="attribute-category collapsible" data-collapse-key="attr-{{key}}">
        <h3 class="collapsible-header"><i class="fas fa-caret-down collapse-caret"></i> {{vtmCapitalize key}} <span class="priority">({{category.priority}})</span>
          <label class="category-total" title="Total Traits in this pool (Trait Bidding), independent of the named chips below">Total
            <input type="number" name="system.attributes.{{key}}.total" value="{{category.total}}" min="0" class="tiny">
          </label>
          <a class="trait-add" data-path="attributes.{{key}}.traits"><i class="fas fa-plus"></i></a>
        </h3>
        <div class="trait-list collapsible-body">
          {{#each category.traits as |trait i|}}
          <span class="trait-chip {{#if trait.negative}}negative{{/if}} {{#if trait.spent}}spent{{/if}}" title="{{#if trait.negative}}Negative Trait{{/if}}">
            <a class="trait-toggle" data-path="attributes.{{key}}.traits" data-index="{{i}}">{{trait.name}}</a>
            <a class="trait-delete" data-path="attributes.{{key}}.traits" data-index="{{i}}"><i class="fas fa-times"></i></a>
          </span>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>

    <div class="tab {{#if tabs.abilities.active}}active{{/if}}" data-group="primary" data-tab="abilities">
      {{#each system.abilities as |list key|}}
      <div class="ability-category collapsible" data-collapse-key="ability-{{key}}">
        <h3 class="collapsible-header"><i class="fas fa-caret-down collapse-caret"></i> {{vtmCapitalize key}}
          <a class="rated-trait-control" data-action="add" data-path="abilities.{{key}}"><i class="fas fa-plus"></i></a>
        </h3>
        <table class="rated-trait-table collapsible-body">
          {{#each list as |ability i|}}
          <tr>
            <td><input type="text" name="system.abilities.{{key}}.{{i}}.name" value="{{ability.name}}"></td>
            <td>
              <a class="rated-trait-control" data-action="decrease" data-path="abilities.{{key}}" data-index="{{i}}">-</a>
              <span class="rating">{{ability.rating}}</span>
              <a class="rated-trait-control" data-action="increase" data-path="abilities.{{key}}" data-index="{{i}}">+</a>
            </td>
            <td><a class="rated-trait-control" data-action="remove" data-path="abilities.{{key}}" data-index="{{i}}"><i class="fas fa-times"></i></a></td>
          </tr>
          {{/each}}
        </table>
      </div>
      {{/each}}
    </div>

    <div class="tab {{#if tabs.powers.active}}active{{/if}}" data-group="primary" data-tab="powers">
      <h3>Disciplines &amp; Powers
        <span class="hint">Drag a Discipline in first, then its Powers stack beneath it automatically. Passive/Toggle powers can be switched on here. Challenge powers must be resolved with the Challenge tool against the opposing party.</span>
        <a class="item-create" data-type="discipline" title="Create new Discipline"><i class="fas fa-plus"></i></a>
        <a class="item-create" data-type="power" title="Create new Power"><i class="fas fa-bolt"></i></a>
      </h3>

      {{#each disciplineGroups as |group|}}
      <div class="discipline-group collapsible" data-collapse-key="disc-{{group.discipline.id}}">
        <div class="item discipline-header collapsible-header" data-item-id="{{group.discipline.id}}">
          <i class="fas fa-caret-down collapse-caret"></i>
          <img src="{{group.discipline.img}}" class="item-img">
          <span class="item-name">{{group.discipline.name}}</span>
          {{#if group.discipline.system.stApprovalRequired}}
          <span class="st-approval-badge" title="Storyteller Approval Required"><i class="fas fa-user-shield"></i> ST</span>
          {{/if}}
          <span class="item-rating">{{group.discipline.system.rating}}</span>
          <a class="item-rating-control" data-item-id="{{group.discipline.id}}" data-action="decrease" title="Decrease rating"><i class="fas fa-minus"></i></a>
          <a class="item-rating-control" data-item-id="{{group.discipline.id}}" data-action="increase" title="Increase rating"><i class="fas fa-plus"></i></a>
          {{#if group.discipline._stats.compendiumSource}}
          <a class="open-source" data-uuid="{{group.discipline._stats.compendiumSource}}" title="Open compendium source"><i class="fas fa-book"></i></a>
          {{/if}}
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </div>
        <ol class="item-list discipline-powers collapsible-body">
          {{#each group.powers as |item|}}
          <li class="item {{#if item.system.active}}power-active{{/if}} {{#if (lookup ../../powerPrereqStatus item.id)}}{{#unless (lookup (lookup ../../powerPrereqStatus item.id) "met")}}prereq-unmet{{/unless}}{{/if}}" data-item-id="{{item.id}}">
            <img src="{{item.img}}" class="item-img">
            <span class="item-name">{{item.name}}</span>
          {{#if item.system.stApprovalRequired}}
          <span class="st-approval-badge" title="Storyteller Approval Required"><i class="fas fa-user-shield"></i> ST</span>
          {{/if}}
            <span class="item-meta">{{item.system.level}} - {{item.system.activation}}</span>
            {{#if item.system.prerequisites}}
            <span class="item-prereqs" title="Prerequisites: {{item.system.prerequisites}}">
              {{#if (lookup (lookup ../../powerPrereqStatus item.id) "met")}}
              <i class="fas fa-check-circle prereq-ok" title="Prerequisites met: {{item.system.prerequisites}}"></i>
              {{else}}
              <i class="fas fa-exclamation-triangle prereq-warn" title="Missing prerequisites: {{lookup (lookup (lookup ../../powerPrereqStatus item.id) "missing") 0}}"></i>
              {{/if}}
            </span>
            {{/if}}
            {{#if (eq item.system.activation "passive")}}
            <span class="item-status">Always On</span>
            {{else if (eq item.system.activation "toggle")}}
            <a class="power-toggle {{#if item.system.active}}is-on{{/if}}" title="Toggle active">
              <i class="fas {{#if item.system.active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i>
            </a>
            {{else if (eq item.system.activation "reflexive")}}
            <a class="power-use" title="Use this Power (posts to chat, no Challenge needed)"><i class="fas fa-bolt"></i> Use</a>
            {{else if (eq item.system.activation "challenge")}}
            <a class="power-challenge" title="Initiate a Challenge using this Power"><i class="fas fa-hand-rock"></i> Challenge</a>
            {{/if}}
            <a class="item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-delete"><i class="fas fa-trash"></i></a>
          </li>
          {{/each}}
          {{#unless group.powers.length}}
          <li class="item-list-empty hint">No Powers yet - drag this Discipline's Basic/Intermediate/Advanced Powers in from the compendium.</li>
          {{/unless}}
        </ol>
      </div>
      {{/each}}

      {{#unless disciplineGroups.length}}
      <p class="hint">No Disciplines yet - drag Discipline items in from the Disciplines &amp; Powers compendium.</p>
      {{/unless}}

      {{#if otherPowers.length}}
      <h3>Other Powers <span class="hint">Combination Disciplines and powers whose Discipline hasn't been added yet</span></h3>
      <ol class="item-list">
        {{#each otherPowers as |item|}}
        <li class="item {{#if item.system.active}}power-active{{/if}} {{#if (lookup ../powerPrereqStatus item.id)}}{{#unless (lookup (lookup ../powerPrereqStatus item.id) "met")}}prereq-unmet{{/unless}}{{/if}}" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          {{#if item.system.stApprovalRequired}}
          <span class="st-approval-badge" title="Storyteller Approval Required"><i class="fas fa-user-shield"></i> ST</span>
          {{/if}}
          <span class="item-meta">{{item.system.discipline}} - {{item.system.level}} - {{item.system.activation}}</span>
          {{#each (vtmParseDisciplineNames item.system.discipline) as |discName|}}
          <a class="open-power-discipline-lore" data-name="{{discName}}" title="Open {{discName}} in the Disciplines compendium"><i class="fas fa-book"></i></a>
          {{/each}}
          {{#if item.system.prerequisites}}
          <span class="item-prereqs" title="Prerequisites: {{item.system.prerequisites}}">
            {{#if (lookup (lookup ../powerPrereqStatus item.id) "met")}}
            <i class="fas fa-check-circle prereq-ok" title="Prerequisites met: {{item.system.prerequisites}}"></i>
            {{else}}
            <i class="fas fa-exclamation-triangle prereq-warn" title="Missing prerequisites: {{lookup (lookup (lookup ../powerPrereqStatus item.id) "missing") 0}}"></i>
            {{/if}}
          </span>
          {{/if}}
          {{#if (eq item.system.activation "passive")}}
          <span class="item-status">Always On</span>
          {{else if (eq item.system.activation "toggle")}}
          <a class="power-toggle {{#if item.system.active}}is-on{{/if}}" title="Toggle active">
            <i class="fas {{#if item.system.active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i>
          </a>
          {{else if (eq item.system.activation "reflexive")}}
          <a class="power-use" title="Use this Power (posts to chat, no Challenge needed)"><i class="fas fa-bolt"></i> Use</a>
          {{else if (eq item.system.activation "challenge")}}
          <a class="power-challenge" title="Initiate a Challenge using this Power"><i class="fas fa-hand-rock"></i> Challenge</a>
          {{/if}}
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      <h3>Rituals <a class="item-create" data-type="ritual" title="Create new Ritual"><i class="fas fa-plus"></i></a></h3>
      <ol class="item-list">
        {{#each itemsByType.ritual as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          {{#if item.system.stApprovalRequired}}
          <span class="st-approval-badge" title="Storyteller Approval Required"><i class="fas fa-user-shield"></i> ST</span>
          {{/if}}
          <span class="item-meta">Level {{item.system.level}}</span>
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
    </div>

    <div class="tab {{#if tabs.backgrounds.active}}active{{/if}}" data-group="primary" data-tab="backgrounds">
      <h3>Backgrounds
        <span class="hint">Drag a Background item from a compendium for a full description, or add a quick text entry directly.</span>
        <a class="item-create" data-type="background" title="Create new Background"><i class="fas fa-plus"></i></a>
        <a class="rated-trait-control" data-action="add" data-path="backgrounds" title="Add a quick text entry"><i class="fas fa-pen"></i></a>
      </h3>
      <ol class="item-list">
        {{#each itemsByType.background as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          {{#if item.system.stApprovalRequired}}
          <span class="st-approval-badge" title="Storyteller Approval Required"><i class="fas fa-user-shield"></i> ST</span>
          {{/if}}
          <span class="item-rating">{{item.system.rating}}</span>
          <a class="item-rating-control" data-item-id="{{item.id}}" data-action="decrease" title="Decrease rating"><i class="fas fa-minus"></i></a>
          <a class="item-rating-control" data-item-id="{{item.id}}" data-action="increase" title="Increase rating"><i class="fas fa-plus"></i></a>
          {{#if item._stats.compendiumSource}}
          <a class="open-source" data-uuid="{{item._stats.compendiumSource}}" title="Open compendium source"><i class="fas fa-book"></i></a>
          {{/if}}
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      {{#if system.backgrounds.length}}
      <table class="rated-trait-table">
        {{#each system.backgrounds as |bg i|}}
        <tr>
          <td><input type="text" name="system.backgrounds.{{i}}.name" value="{{bg.name}}"></td>
          <td>
            <a class="rated-trait-control" data-action="decrease" data-path="backgrounds" data-index="{{i}}">-</a>
            <span class="rating">{{bg.rating}}</span>
            <a class="rated-trait-control" data-action="increase" data-path="backgrounds" data-index="{{i}}">+</a>
          </td>
          <td><a class="rated-trait-control" data-action="remove" data-path="backgrounds" data-index="{{i}}"><i class="fas fa-times"></i></a></td>
        </tr>
        {{/each}}
      </table>
      {{/if}}
    </div>

    <div class="tab {{#if tabs.meritsflaws.active}}active{{/if}}" data-group="primary" data-tab="meritsflaws">
      <h3>Merits <a class="item-create" data-type="merit" title="Create new Merit"><i class="fas fa-plus"></i></a></h3>
      <ol class="item-list">
        {{#each itemsByType.merit as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          {{#if item.system.stApprovalRequired}}
          <span class="st-approval-badge" title="Storyteller Approval Required"><i class="fas fa-user-shield"></i> ST</span>
          {{/if}}
          <span class="item-rating">{{item.system.cost}}</span>
          {{#if item._stats.compendiumSource}}
          <a class="open-source" data-uuid="{{item._stats.compendiumSource}}" title="Open compendium source"><i class="fas fa-book"></i></a>
          {{/if}}
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <h3>Flaws <a class="item-create" data-type="flaw" title="Create new Flaw"><i class="fas fa-plus"></i></a></h3>
      <ol class="item-list">
        {{#each itemsByType.flaw as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          {{#if item.system.stApprovalRequired}}
          <span class="st-approval-badge" title="Storyteller Approval Required"><i class="fas fa-user-shield"></i> ST</span>
          {{/if}}
          <span class="item-rating">{{item.system.bonus}}</span>
          {{#if item._stats.compendiumSource}}
          <a class="open-source" data-uuid="{{item._stats.compendiumSource}}" title="Open compendium source"><i class="fas fa-book"></i></a>
          {{/if}}
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
    </div>

    <div class="tab {{#if tabs.gear.active}}active{{/if}}" data-group="primary" data-tab="gear">
      <h3>Gear &amp; Weapons
        <span class="hint">Trait Bonus is shown automatically in the Resolve Challenge dialog as a manual reminder.</span>
        <a class="item-create" data-type="gear" title="Create new Gear"><i class="fas fa-plus"></i></a>
      </h3>
      <ol class="item-list">
        {{#each itemsByType.gear as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          {{#if item.system.stApprovalRequired}}
          <span class="st-approval-badge" title="Storyteller Approval Required"><i class="fas fa-user-shield"></i> ST</span>
          {{/if}}
          <span class="item-meta">x{{item.system.quantity}} {{#if item.system.traitBonus}}({{item.system.traitBonus}}){{/if}}</span>
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
    </div>

    <div class="tab {{#if tabs.social.active}}active{{/if}}" data-group="primary" data-tab="social">
      <h3>Derangements <a class="simple-list-add" data-path="derangements"><i class="fas fa-plus"></i></a></h3>
      <div class="simple-list">
        {{#each system.derangements as |d i|}}
        <div class="simple-list-row">
          <input type="text" name="system.derangements.{{i}}.name" value="{{d.name}}" placeholder="Derangement name" class="tiny">
          <input type="text" name="system.derangements.{{i}}.description" value="{{d.description}}" placeholder="Trigger/description" class="wide">
          <a class="simple-list-remove" data-path="derangements" data-index="{{i}}"><i class="fas fa-times"></i></a>
        </div>
        {{/each}}
      </div>

      <h3>Blood Bonds <span class="hint">1-3 = ordinary Blood Bond (3 = Full Bond); Sabbat Vinculum uses the full 1-10 scale, resolved via the Vaulderie tool</span> <a class="simple-list-add" data-path="bloodBonds"><i class="fas fa-plus"></i></a></h3>
      <div class="simple-list">
        {{#each system.bloodBonds as |b i|}}
        <div class="simple-list-row">
          <input type="text" name="system.bloodBonds.{{i}}.name" value="{{b.name}}" placeholder="Bonded to whom" class="tiny">
          <input type="number" name="system.bloodBonds.{{i}}.level" value="{{b.level}}" min="1" max="10" class="tiny" title="1-3: ordinary bond (3 = Full Bond). 1-10: Sabbat Vinculum.">
          <input type="text" name="system.bloodBonds.{{i}}.notes" value="{{b.notes}}" placeholder="Notes" class="wide">
          <a class="simple-list-remove" data-path="bloodBonds" data-index="{{i}}"><i class="fas fa-times"></i></a>
        </div>
        {{/each}}
      </div>

      <h3>Boons <a class="simple-list-add" data-path="boons"><i class="fas fa-plus"></i></a></h3>
      <div class="simple-list">
        {{#each system.boons as |bo i|}}
        <div class="simple-list-row">
          <select name="system.boons.{{i}}.direction">
            <option value="owed" {{#if (eq bo.direction "owed")}}selected{{/if}}>I owe</option>
            <option value="owedToMe" {{#if (eq bo.direction "owedToMe")}}selected{{/if}}>Owed to me</option>
          </select>
          <input type="text" name="system.boons.{{i}}.who" value="{{bo.who}}" placeholder="Who" class="tiny">
          <select name="system.boons.{{i}}.type">
            <option value="minor" {{#if (eq bo.type "minor")}}selected{{/if}}>Minor</option>
            <option value="major" {{#if (eq bo.type "major")}}selected{{/if}}>Major</option>
            <option value="blood" {{#if (eq bo.type "blood")}}selected{{/if}}>Blood</option>
          </select>
          <input type="text" name="system.boons.{{i}}.notes" value="{{bo.notes}}" placeholder="Notes" class="wide">
          <a class="simple-list-remove" data-path="boons" data-index="{{i}}"><i class="fas fa-times"></i></a>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="tab {{#if tabs.bio.active}}active{{/if}}" data-group="primary" data-tab="bio">
      <h3>Concept</h3>
      <input type="text" name="system.concept" value="{{system.concept}}">
      <h3>Biography</h3>
      <prose-mirror name="system.biography" value="{{{system.biography}}}" {{#unless owner}}disabled{{/unless}} toggled button></prose-mirror>
      <h3>Notes</h3>
      <prose-mirror name="system.notes" value="{{{system.notes}}}" {{#unless owner}}disabled{{/unless}} toggled button></prose-mirror>
    </div>

  </section>
</form>
