<form class="{{cssClass}} flexcol" autocomplete="off">

  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    <div class="header-fields flexcol">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Character Name">
      <div class="flexrow header-grid">
        <label>Clan <input type="text" name="system.clan" value="{{system.clan}}"></label>
        <label>Bloodline <input type="text" name="system.bloodline" value="{{system.bloodline}}"></label>
        <label>Sect <input type="text" name="system.sect" value="{{system.sect}}"></label>
        <label>Generation <input type="number" name="system.generation" value="{{system.generation}}"></label>
        <label>Nature <input type="text" name="system.nature" value="{{system.nature}}"></label>
        <label>Demeanor <input type="text" name="system.demeanor" value="{{system.demeanor}}"></label>
        <label>Title <input type="text" name="system.title" value="{{system.title}}"></label>
        <label>Coterie <input type="text" name="system.coterie" value="{{system.coterie}}"></label>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="main">Main</a>
    <a class="item" data-tab="traits">Attributes &amp; Abilities</a>
    <a class="item" data-tab="powers">Disciplines &amp; Powers</a>
    <a class="item" data-tab="backgrounds">Backgrounds</a>
    <a class="item" data-tab="meritsflaws">Merits &amp; Flaws</a>
    <a class="item" data-tab="gear">Gear</a>
    <a class="item" data-tab="bio">Biography</a>
  </nav>

  <section class="sheet-body">

    <div class="tab" data-group="primary" data-tab="main">
      <div class="pools flexrow">
        <div class="pool">
          <label>Willpower</label>
          <input type="number" name="system.willpower.value" value="{{system.willpower.value}}">
          / <input type="number" name="system.willpower.max" value="{{system.willpower.max}}">
        </div>
        <div class="pool">
          <label>Blood</label>
          <input type="number" name="system.blood.value" value="{{system.blood.value}}">
          / <input type="number" name="system.blood.max" value="{{system.blood.max}}">
          (per turn <input type="number" name="system.blood.perTurn" value="{{system.blood.perTurn}}" class="tiny">)
        </div>
        <div class="pool">
          <label>{{system.morality.path}}</label>
          <input type="text" name="system.morality.path" value="{{system.morality.path}}" class="tiny">
          <input type="number" name="system.morality.rating" value="{{system.morality.rating}}">
        </div>
      </div>

      <div class="virtues flexrow">
        <div class="virtue">
          <label>Conscience/Conviction</label>
          <input type="number" name="system.virtues.conscienceConviction.rating" value="{{system.virtues.conscienceConviction.rating}}">
        </div>
        <div class="virtue">
          <label>Self-Control/Instinct</label>
          <input type="number" name="system.virtues.selfControlInstinct.rating" value="{{system.virtues.selfControlInstinct.rating}}">
        </div>
        <div class="virtue">
          <label>Courage</label>
          <input type="number" name="system.virtues.courage.rating" value="{{system.virtues.courage.rating}}">
        </div>
      </div>

      <h3>Health <span class="hint">Click to take damage. Shift-click to heal a bashing/lethal box by spending 1 Blood.</span></h3>
      <div class="health-track flexrow">
        {{#each healthLevels as |level|}}
        <div class="health-box state-{{level.state}}" data-level="{{level.key}}" title="{{level.label}} ({{level.state}}) - click to cycle, shift-click to heal with Blood">
          <span class="label">{{level.label}}</span>
          <span class="state">{{level.state}}</span>
        </div>
        {{/each}}
      </div>

      <div class="flexrow">
        <button type="button" class="open-challenge"><i class="fas fa-hand-rock"></i> Resolve Challenge</button>
        <button type="button" class="open-frenzy"><i class="fas fa-burst"></i> Frenzy / Rötschreck Check</button>
      </div>

      {{#if activePowers.length}}
      <h3>Active Powers</h3>
      <div class="active-powers flexrow">
        {{#each activePowers as |item|}}
        <span class="trait-chip">{{item.name}}</span>
        {{/each}}
      </div>
      {{/if}}
    </div>

    <div class="tab" data-group="primary" data-tab="traits">
      {{#each system.attributes as |category key|}}
      <div class="attribute-category">
        <h3>{{vtmCapitalize key}} <span class="priority">({{category.priority}})</span>
          <a class="trait-add" data-path="attributes.{{key}}.traits"><i class="fas fa-plus"></i></a>
        </h3>
        <div class="trait-list">
          {{#each category.traits as |trait i|}}
          <span class="trait-chip {{#if trait.spent}}spent{{/if}}">
            <a class="trait-toggle" data-path="attributes.{{key}}.traits" data-index="{{i}}">{{trait.name}}</a>
            <a class="trait-delete" data-path="attributes.{{key}}.traits" data-index="{{i}}"><i class="fas fa-times"></i></a>
          </span>
          {{/each}}
        </div>
      </div>
      {{/each}}

      <div class="attribute-category">
        <h3>Negative Traits
          <a class="trait-add" data-path="negativeTraits"><i class="fas fa-plus"></i></a>
        </h3>
        <div class="trait-list">
          {{#each system.negativeTraits as |trait i|}}
          <span class="trait-chip negative {{#if trait.spent}}spent{{/if}}">
            <a class="trait-toggle" data-path="negativeTraits" data-index="{{i}}">{{trait.name}}</a>
            <a class="trait-delete" data-path="negativeTraits" data-index="{{i}}"><i class="fas fa-times"></i></a>
          </span>
          {{/each}}
        </div>
      </div>

      {{#each system.abilities as |list key|}}
      <div class="ability-category">
        <h3>{{vtmCapitalize key}}
          <a class="rated-trait-control" data-action="add" data-path="abilities.{{key}}"><i class="fas fa-plus"></i></a>
        </h3>
        <table class="rated-trait-table">
          {{#each list as |ability i|}}
          <tr>
            <td><input type="text" name="system.abilities.{{key}}.{{i}}.name" value="{{ability.name}}"></td>
            <td>
              <a class="rated-trait-control" data-action="decrease" data-path="abilities.{{key}}" data-index="{{i}}">-</a>
              <span class="rating">{{ability.rating}}</span>
              <a class="rated-trait-control" data-action="increase" data-path="abilities.{{key}}" data-index="{{i}}">+</a>
            </td>
            <td><a class="rated-trait-control" data-action="remove" data-path="abilities.{{key}}" data-index="{{i}}"><i class="fas fa-times"></i></a></td>
          </tr>
          {{/each}}
        </table>
      </div>
      {{/each}}
    </div>

    <div class="tab" data-group="primary" data-tab="powers">
      <h3>Disciplines
        <span class="hint">Drag Discipline items from a compendium, or</span>
        <a class="item-create" data-type="discipline" title="Create new Discipline"><i class="fas fa-plus"></i></a>
      </h3>
      <ol class="item-list">
        {{#each itemsByType.discipline as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          <span class="item-rating">{{item.system.rating}}</span>
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>

      <h3>Powers
        <span class="hint">Passive/Toggle powers can be switched on here. Challenge powers must be resolved with the Challenge tool against the opposing party.</span>
        <a class="item-create" data-type="power" title="Create new Power"><i class="fas fa-plus"></i></a>
      </h3>
      <ol class="item-list">
        {{#each itemsByType.power as |item|}}
        {{#with (lookup ../powerPrereqStatus item.id) as |prereq|}}
        <li class="item {{#if item.system.active}}power-active{{/if}} {{#if prereq}}{{#unless prereq.met}}prereq-unmet{{/unless}}{{/if}}" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          <span class="item-meta">{{item.system.discipline}} - {{item.system.level}} - {{item.system.activation}}</span>
          {{#if item.system.prerequisites}}
          <span class="item-prereqs" title="Prerequisites: {{item.system.prerequisites}}">
            {{#if prereq.met}}
            <i class="fas fa-check-circle prereq-ok" title="Prerequisites met: {{item.system.prerequisites}}"></i>
            {{else}}
            <i class="fas fa-exclamation-triangle prereq-warn" title="Missing prerequisites: {{prereq.missing.[0]}}"></i>
            {{/if}}
          </span>
          {{/if}}
          {{#if (eq item.system.activation "passive")}}
          <span class="item-status">Always On</span>
          {{else if (eq item.system.activation "toggle")}}
          <a class="power-toggle {{#if item.system.active}}is-on{{/if}}" title="Toggle active">
            <i class="fas {{#if item.system.active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i>
          </a>
          {{/if}}
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/with}}
        {{/each}}
      </ol>

      <h3>Rituals <a class="item-create" data-type="ritual" title="Create new Ritual"><i class="fas fa-plus"></i></a></h3>
      <ol class="item-list">
        {{#each itemsByType.ritual as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          <span class="item-meta">Level {{item.system.level}}</span>
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
    </div>

    <div class="tab" data-group="primary" data-tab="backgrounds">
      <h3>Backgrounds
        <a class="rated-trait-control" data-action="add" data-path="backgrounds"><i class="fas fa-plus"></i></a>
      </h3>
      <table class="rated-trait-table">
        {{#each system.backgrounds as |bg i|}}
        <tr>
          <td><input type="text" name="system.backgrounds.{{i}}.name" value="{{bg.name}}"></td>
          <td>
            <a class="rated-trait-control" data-action="decrease" data-path="backgrounds" data-index="{{i}}">-</a>
            <span class="rating">{{bg.rating}}</span>
            <a class="rated-trait-control" data-action="increase" data-path="backgrounds" data-index="{{i}}">+</a>
          </td>
          <td><a class="rated-trait-control" data-action="remove" data-path="backgrounds" data-index="{{i}}"><i class="fas fa-times"></i></a></td>
        </tr>
        {{/each}}
      </table>

      <h3>Background Items <a class="item-create" data-type="background" title="Create new Background"><i class="fas fa-plus"></i></a></h3>
      <span class="hint">Drag Background items from a compendium for full descriptions.</span>
      <ol class="item-list">
        {{#each itemsByType.background as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          <span class="item-rating">{{item.system.rating}}</span>
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
    </div>

    <div class="tab" data-group="primary" data-tab="meritsflaws">
      <h3>Merits <a class="item-create" data-type="merit" title="Create new Merit"><i class="fas fa-plus"></i></a></h3>
      <ol class="item-list">
        {{#each itemsByType.merit as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          <span class="item-rating">{{item.system.cost}}</span>
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <h3>Flaws <a class="item-create" data-type="flaw" title="Create new Flaw"><i class="fas fa-plus"></i></a></h3>
      <ol class="item-list">
        {{#each itemsByType.flaw as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          <span class="item-rating">{{item.system.bonus}}</span>
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
    </div>

    <div class="tab" data-group="primary" data-tab="gear">
      <h3>Gear &amp; Weapons
        <span class="hint">Trait Bonus is shown automatically in the Resolve Challenge dialog as a manual reminder.</span>
        <a class="item-create" data-type="gear" title="Create new Gear"><i class="fas fa-plus"></i></a>
      </h3>
      <ol class="item-list">
        {{#each itemsByType.gear as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <img src="{{item.img}}" class="item-img">
          <span class="item-name">{{item.name}}</span>
          <span class="item-meta">x{{item.system.quantity}} {{#if item.system.traitBonus}}({{item.system.traitBonus}}){{/if}}</span>
          <a class="item-edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
    </div>

    <div class="tab" data-group="primary" data-tab="bio">
      <h3>Concept</h3>
      <input type="text" name="system.concept" value="{{system.concept}}">
      <h3>Biography</h3>
      {{editor system.biography target="system.biography" button=true engine="prosemirror" owner=owner}}
      <h3>Notes</h3>
      {{editor system.notes target="system.notes" button=true engine="prosemirror" owner=owner}}
    </div>

  </section>
</form>
